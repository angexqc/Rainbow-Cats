page {
  background-color: var(--rc-bg);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.header-side {
  width: 88px;
  display: flex;
  align-items: center;
}

.header-side-right {
  justify-content: flex-end;
}

.icon-action {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  font-size: 20px;
}

.header-save {
  min-width: 56px;
  height: 32px;
  border-radius: 16px;
  background: var(--rc-primary-container);
  color: var(--rc-on-primary-container);
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 12px;
  box-sizing: border-box;
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.form-card {
  background-color: var(--rc-surface);
  border-radius: 16px;
  border: 1px solid var(--rc-border);
  padding: 16px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 18px;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 13px;
  font-weight: 500;
  color: var(--rc-text-secondary);
}

.required {
  color: var(--rc-warning);
}

.input-wrap,
.upload-box {
  background-color: var(--rc-surface-2);
  border: 1px solid var(--rc-border);
  border-radius: 12px;
  box-sizing: border-box;
}

.input-wrap {
  height: 48px;
  display: flex;
  align-items: center;
  padding: 0 12px;
}

.input {
  width: 100%;
  height: 100%;
  font-size: 14px;
  color: var(--rc-text);
}

.placeholder {
  color: var(--rc-text-tertiary);
}

.upload-box {
  height: 180px;
  border-style: dashed;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-text {
  font-size: 14px;
  color: var(--rc-text-secondary);
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.hint {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.textarea-wrap {
  min-height: 108px;
  align-items: flex-start;
  padding: 12px;
}

.textarea {
  width: 100%;
  min-height: 84px;
  font-size: 14px;
  color: var(--rc-text);
}

.picker-wrap {
  justify-content: space-between;
}

.picker-text {
  font-size: 14px;
  color: var(--rc-text);
}

.picker-arrow {
  font-size: 18px;
  color: var(--rc-text-secondary);
}
