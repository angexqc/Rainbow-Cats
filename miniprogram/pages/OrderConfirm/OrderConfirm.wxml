<view class="page">
  <view class="header" style="padding-top: {{topSafeHeight}}px; height: {{topSafeHeight + 64}}px;">
    <text bindtap="handleBack">←</text>
    <text>确认订单</text>
    <text></text>
  </view>

  <view class="content" wx:if="{{cartItems && cartItems.length > 0}}">
    <view class="section-title">订单明细</view>

    <view wx:if="{{pair && pair.isPaired}}" class="collab-context">
      <view class="collab-person"><image wx:if="{{pair.myInfo.avatarUrl}}" src="{{pair.myInfo.avatarUrl}}" mode="aspectFill"></image><text wx:else>我</text><label>我</label></view>
      <view class="collab-arrow">→</view>
      <view class="collab-person"><image wx:if="{{pair.partnerInfo.avatarUrl}}" src="{{pair.partnerInfo.avatarUrl}}" mode="aspectFill"></image><text wx:else>TA</text><label>{{pair.partnerInfo.nickName || 'TA'}}</label></view>
        <text class="collab-status">待 TA 确认</text>
    </view>

    <view class="order-items">
      <view wx:for="{{cartItems}}" wx:key="menuId" class="order-item">
        <image class="item-thumb" src="{{item.image}}" mode="aspectFill"></image>
        <view class="item-info">
          <text class="item-name">{{item.title}}</text>
          <text class="item-credit">x {{item.count}}</text>
        </view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="remark-section">
      <view class="section-title">备注</view>
      <textarea
        class="remark-input"
        placeholder="如：少辣"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="100"
      ></textarea>
    </view>

    <view class="divider"></view>

    <view class="summary-section">
      <view class="summary-row">
        <text class="label">菜品总份数：</text>
        <text class="amount">{{totalCount}} 份</text>
      </view>
    </view>

    <view class="confirm-tip">
      <text>确认后将生成订单并进入待确认状态</text>
      <text class="notify-result">{{notifyResultText}}</text>
      <text wx:if="{{conflictTerms.length}}" class="conflict-tip">可能涉及：{{conflictTerms.join('、')}}，请自行确认</text>
    </view>

    <button class="btn biz-action biz-primary" bindtap="handleConfirm">确认下单</button>
  </view>

  <view wx:if="{{cartItems ? (cartItems.length === 0) : true}}" class="empty-state">
    <text>购物车为空</text>
  </view>

  <view wx:if="{{loading}}" class="loading cat-loader">
    <view class="loading-panel">
      <cat-lottie-loader size="{{78}}"></cat-lottie-loader>
    </view>
  </view>
</view>
