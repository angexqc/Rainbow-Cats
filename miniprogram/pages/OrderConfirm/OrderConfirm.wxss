page {
  background-color: var(--rc-bg);
}

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  height: 56px;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  border-bottom: 1px solid var(--rc-border);
  background-color: var(--rc-surface-glass);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.header text {
  font-size: 19px;
  font-weight: 600;
  letter-spacing: 0.6px;
  color: var(--rc-text);
}

.header text:first-child {
  position: absolute;
  left: var(--rc-page-gutter);
  font-size: 20px;
  font-weight: 400;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.header text:first-child:active {
  transform: translateY(1px) scale(0.92);
  opacity: 0.8;
}

.header text:last-child {
  width: 20px;
}

.content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 18px 16px;
  animation: confirm-enter var(--rc-motion-medium) var(--rc-ease-out) both;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--rc-text);
  margin-bottom: 12px;
}

.order-items,
.remark-section,
.summary-section {
  background-color: var(--rc-surface);
  border-radius: 16px;
  padding: 14px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  transition: transform var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out);
}

.order-items:active,
.remark-section:active,
.summary-section:active {
  transform: translateY(1px) scale(0.995);
  box-shadow: 0 8px 18px rgba(45, 137, 87, 0.12);
}

.order-items {
  margin-bottom: 12px;
}

.order-item {
  display: flex;
  gap: 12px;
}

.order-item + .order-item {
  margin-top: 12px;
}

.item-thumb {
  width: 48px;
  height: 48px;
  border-radius: 8px;
  background-color: var(--rc-surface-2);
  transition: transform var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.item-name {
  font-size: 14px;
  color: var(--rc-text);
}

.item-credit {
  margin-top: 4px;
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.label {
  font-size: 14px;
  color: var(--rc-text-secondary);
}

.amount {
  font-size: 16px;
  font-weight: 600;
  color: var(--rc-text);
}

.remark-section {
  margin-bottom: 12px;
}

.remark-input {
  margin-top: 8px;
  border: 1px solid var(--rc-border-strong);
  border-radius: 12px;
  padding: 10px 12px;
  font-size: 14px;
  min-height: 80px;
  transition: border-color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), background-color var(--rc-motion-fast) var(--rc-ease-out);
}

.remark-input:focus {
  border-color: var(--rc-primary);
  box-shadow: 0 0 0 3px rgba(45, 137, 87, 0.16);
  background: var(--rc-surface);
}

.summary-section {
  margin-bottom: 12px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.divider {
  display: none;
}

.confirm-tip {
  font-size: 12px;
  color: var(--rc-text-secondary);
  text-align: center;
  margin: 10px 0 14px;
}

.btn {
  height: 44px;
  border-radius: 22px;
  border: none;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), box-shadow var(--rc-motion-fast) var(--rc-ease-out), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.btn:active {
  transform: translateY(1px) scale(0.98);
}

.btn-primary {
  background-color: var(--rc-primary);
  color: var(--rc-on-primary);
}

.empty-state,
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--rc-text-secondary);
}

.empty-state {
  padding: 90px 0;
  animation: confirm-empty-fade var(--rc-motion-medium) var(--rc-ease-out) both;
}

.loading {
  position: absolute;
  inset: 0;
  z-index: 30;
  background: rgba(244, 251, 247, 0.86);
  backdrop-filter: none;
  animation: confirm-loading-fade var(--rc-motion-fast) var(--rc-ease-out) both;
}

.loading-panel {
  width: 140px;
  height: 140px;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(214, 242, 225, 0.92);
  box-shadow: 0 8px 20px rgba(57, 80, 96, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes confirm-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes confirm-empty-fade {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes confirm-loading-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Figma Site confirm order. */
.header {
  background: transparent;
  border-bottom: 0;
  box-shadow: none;
}

.content {
  padding: 12px 14px 92px;
}

.section-title {
  font-size: 15px;
  font-weight: 900;
}

.order-items,
.remark-section,
.summary-section,
.confirm-tip {
  border-radius: 24px;
  background: var(--rc-surface);
  border: 1rpx solid var(--rc-border-strong);
  box-shadow: var(--rc-shadow-card);
  padding: 14px;
}

.order-item {
  border-radius: 18px;
  background: var(--rc-surface-2);
}

.item-thumb {
  border-radius: 16px;
}

.remark-input {
  border-radius: 18px;
}

.amount {
  color: var(--rc-primary);
  font-weight: 900;
}

.btn {
  height: 44px;
  border-radius: 999px;
  font-weight: 900;
}
.collab-context { display:flex; align-items:center; gap:10px; margin:0 0 16px; padding:12px; border-radius:12px; background:var(--rc-primary-container); }
.collab-person { display:flex; align-items:center; gap:6px; color:var(--rc-primary-strong); font-size:12px; font-weight:700; }
.collab-person image,.collab-person text { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:var(--rc-surface); color:var(--rc-primary-strong); font-size:12px; }
.collab-person label { max-width:72px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.collab-arrow { color:var(--rc-primary-strong); font-size:18px; }
.collab-status { margin-left:auto; color:var(--rc-primary-strong); font-size:11px; }
.notify-result,.conflict-tip { display:block; margin-top:6px; color:var(--rc-text-secondary); font-size:11px; line-height:1.5; }
.conflict-tip { color:var(--rc-warning); }
