page {
  background-color: var(--rc-bg);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  height: 56px;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 12px 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.unpaired-card,
.paired-card,
.qr-card,
.code-card {
  background-color: var(--rc-surface);
  border-radius: var(--rc-radius-card);
  padding: 16px;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--rc-text);
}

.card-desc {
  margin-top: 8px;
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.section-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--rc-text);
}

.qr-card {
  min-height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12px;
}

.qr-placeholder {
  width: 160px;
  height: 160px;
  border-radius: var(--rc-radius-field);
  background-color: var(--rc-bg);
  color: var(--rc-text-secondary);
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-image {
  width: 160px;
  height: 160px;
  border-radius: var(--rc-radius-field);
  background-color: var(--rc-on-primary);
}

.qr-text {
  font-size: 14px;
  font-weight: 500;
  color: var(--rc-text);
}

.qr-text-row {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
}

.copy-icon-btn {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  color: var(--rc-primary-strong);
  text-align: center;
  line-height: 24px;
  font-size: 12px;
}

.input-row {
  width: 100%;
  display: flex;
  gap: 8px;
}

.code-input {
  flex: 4;
  height: 44px;
  background-color: var(--rc-surface);
  border: 1px solid var(--rc-border);
  border-radius: var(--rc-radius-field);
  display: flex;
  align-items: center;
  padding-right: 6px;
  box-sizing: border-box;
}

.code-input input {
  width: 100%;
  height: 100%;
  padding: 0 10px 0 12px;
  box-sizing: border-box;
  font-size: 14px;
  color: var(--rc-text);
}

.scan-icon-btn {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
}

.scan-corner {
  position: absolute;
  width: 6px;
  height: 6px;
  border-color: var(--rc-primary-strong);
}

.scan-corner.tl {
  left: 7px;
  top: 7px;
  border-left: 1.5px solid var(--rc-primary-strong);
  border-top: 1.5px solid var(--rc-primary-strong);
}

.scan-corner.tr {
  right: 7px;
  top: 7px;
  border-right: 1.5px solid var(--rc-primary-strong);
  border-top: 1.5px solid var(--rc-primary-strong);
}

.scan-corner.bl {
  left: 7px;
  bottom: 7px;
  border-left: 1.5px solid var(--rc-primary-strong);
  border-bottom: 1.5px solid var(--rc-primary-strong);
}

.scan-corner.br {
  right: 7px;
  bottom: 7px;
  border-right: 1.5px solid var(--rc-primary-strong);
  border-bottom: 1.5px solid var(--rc-primary-strong);
}

.scan-line {
  position: absolute;
  left: 8px;
  right: 8px;
  top: 14px;
  height: 1.5px;
  border-radius: 1px;
  background: var(--rc-primary);
}

.placeholder {
  color: var(--rc-text-secondary);
}

.bind-btn,
.regen-btn,
.unbind-btn,
.skip-btn {
  height: 44px;
  border-radius: var(--rc-radius-field);
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-btn {
  flex: 2;
  min-width: 0;
}

.bind-btn[disabled] {
  background-color: var(--rc-border);
  border-color: var(--rc-border);
  color: var(--rc-text-secondary);
}

.expire-tip {
  text-align: center;
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.skip-btn {
  width: 100%;
  color: var(--rc-text-secondary);
  border: 1px solid var(--rc-border);
  background-color: var(--rc-surface);
}

.skip-entry {
  width: 100%;
  min-height: 60px;
  padding: 12px 14px;
  border-radius: var(--rc-radius-card);
  border: 1px solid var(--rc-border);
  background: var(--rc-surface-2);
  box-shadow: 0 4px 12px rgba(45, 137, 87, 0.16);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.skip-copy {
  flex: 1;
  min-width: 0;
}

.skip-title {
  font-size: 14px;
  line-height: 20px;
  color: var(--rc-primary-strong);
  font-weight: 600;
}

.skip-subtitle {
  margin-top: 2px;
  font-size: 12px;
  line-height: 18px;
  color: var(--rc-text-secondary);
}

.skip-arrow {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background: rgba(45, 137, 87, 0.16);
  color: var(--rc-primary-strong);
  font-size: 18px;
  line-height: 24px;
  text-align: center;
}

.paired-card {
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: var(--rc-bg);
}

.partner-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--rc-text);
}

.bind-time {
  margin-top: 4px;
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.paired-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.regen-btn {
  width: 100%;
}

.home-btn {
  width: 100%;
}

.code-label {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.code-text {
  margin-top: 8px;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 1px;
  color: var(--rc-primary-strong);
}

.unbind-btn {
  width: 100%;
}

/* Figma Site pairing states. */
.header {
  background: transparent;
  border-bottom: 0;
  box-shadow: none;
}

.title {
  font-size: 22px;
  font-weight: 900;
}

.content {
  padding: 12px 14px 86px;
  gap: 12px;
}

.unpaired-card,
.paired-card,
.qr-card,
.code-card,
.skip-entry {
  border-radius: 28px;
}

.unpaired-card {
  min-height: 118px;
  justify-content: center;
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 216, 136, 0.42), transparent 34%),
    var(--rc-surface);
}

.card-title,
.partner-name {
  font-size: 20px;
  font-weight: 900;
}

.section-title,
.expire-tip,
.skip-subtitle,
.bind-time,
.code-label {
  font-weight: 750;
}

.qr-card {
  min-height: 196px;
}

.qr-placeholder,
.qr-image {
  width: 142px;
  height: 142px;
  border-radius: 24px;
}

.qr-text,
.code-text {
  font-weight: 900;
  letter-spacing: 1.4px;
}

.code-input,
.bind-btn,
.regen-btn,
.home-btn,
.unbind-btn {
  height: 44px;
  border-radius: 999px;
}

.skip-entry {
  min-height: 68px;
}

.paired-card {
  gap: 12px;
}

.avatar {
  width: 62px;
  height: 62px;
  border-radius: 31px;
}
