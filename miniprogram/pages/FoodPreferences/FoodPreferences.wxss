page { background:var(--rc-bg); }
.page { height:100vh; overflow:hidden; }
.header { display:flex; align-items:center; justify-content:space-between; padding:0 var(--rc-page-gutter); box-sizing:border-box; border-bottom:1px solid var(--rc-border); background:var(--rc-surface-glass); }
.back,.space { width:34px; height:34px; }.back { border-radius:17px; background:var(--rc-surface); color:var(--rc-primary-strong); font-size:28px; line-height:31px; text-align:center; }.title { font-size:19px; font-weight:700; color:var(--rc-text); }
.content { height:calc(100vh - 56px); padding:16px var(--rc-page-gutter) 30px; box-sizing:border-box; }
.block { margin-bottom:12px; padding:16px; border-radius:16px; background:var(--rc-surface); border:1px solid var(--rc-border); }.block.warning { background:var(--rc-warning-bg); }.block.row { display:flex; align-items:center; justify-content:space-between; gap:16px; }
.label { color:var(--rc-text); font-size:14px; font-weight:700; }.options { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }.option { min-height:32px; padding:0 11px; border-radius:10px; background:var(--rc-muted-bg); color:var(--rc-text-secondary); font-size:12px; line-height:32px; }.option.active { background:var(--rc-primary-container); color:var(--rc-primary-strong); font-weight:700; }
.input { width:100%; height:72px; margin-top:10px; padding:10px; box-sizing:border-box; border-radius:10px; background:var(--rc-glass-strong); color:var(--rc-text); font-size:12px; }.hint { margin-top:8px; color:var(--rc-text-secondary); font-size:10px; line-height:1.5; }.save { height:46px; border-radius:14px; background:var(--rc-primary); color:var(--rc-on-primary); font-size:14px; font-weight:700; line-height:46px; }.save::after { border:0; }
