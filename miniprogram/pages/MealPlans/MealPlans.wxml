<view class="page"><view class="header" style="padding-top:{{topSafeHeight}}px;height:{{topSafeHeight + 64}}px;"><view class="back" bindtap="handleBack">‹</view><view class="title">用餐计划</view><view class="space"></view></view><scroll-view class="content" scroll-y>
<view class="form"><view class="form-title">安排下一顿</view><picker mode="date" value="{{planDate}}" bindchange="onDate"><view class="field">日期：{{planDate}}</view></picker><view class="meal-row"><view class="meal {{mealType === 'lunch' ? 'active' : ''}}" data-type="lunch" bindtap="setMeal">午餐</view><view class="meal {{mealType === 'dinner' ? 'active' : ''}}" data-type="dinner" bindtap="setMeal">晚餐</view></view><picker mode="selector" range="{{menus}}" range-key="title" value="{{menuIndex}}" bindchange="onMenu"><view class="field">菜品：{{menus.length ? menus[menuIndex].title : '暂无可选菜品'}}</view></picker><input class="field" value="{{remark}}" bindinput="onRemark" placeholder="备注（选填）" maxlength="200"/><button class="primary" bindtap="create">创建计划</button></view><view class="plan-tabs"><view class="plan-tab {{!history ? 'active' : ''}}" data-history="false" bindtap="switchHistory">进行中</view><view class="plan-tab {{history ? 'active' : ''}}" data-history="true" bindtap="switchHistory">历史</view></view>
<view wx:for="{{plans}}" wx:key="id" class="plan"><image class="thumb" src="{{item.menu.image}}" mode="aspectFill"></image><view class="body"><view class="plan-head"><text class="name">{{item.menu.title}}</text><text class="status">{{item.status === 'confirmed' ? '已确认' : (item.status === 'expired' ? '已过期' : (item.status === 'cancelled' ? '已取消' : '待确认'))}}</text></view><text class="meta">{{item.planDate}} · {{mealLabels[item.mealType]}} · {{item.createdByRole === 'me' ? '我创建' : 'TA 创建'}}</text><text wx:if="{{item.remark}}" class="remark">{{item.remark}}</text><view class="actions"><view wx:if="{{!history && item.status === 'planned'}}" data-id="{{item.id}}" bindtap="confirm">确认</view><view data-id="{{item.id}}" bindtap="addCart">加入购物车</view><view wx:if="{{!history && item.createdByRole === 'me'}}" class="danger" data-id="{{item.id}}" bindtap="remove">取消</view></view></view></view>
<view wx:if="{{!loading && !plans.length}}" class="empty">还没有用餐计划</view></scroll-view></view>
