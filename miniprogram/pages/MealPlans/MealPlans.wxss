page{background:var(--rc-bg)}.page{height:100vh;overflow:hidden}.header{display:flex;align-items:center;justify-content:space-between;padding:0 var(--rc-page-gutter);box-sizing:border-box;border-bottom:1px solid var(--rc-border);background:var(--rc-surface-glass)}.back,.space{width:34px;height:34px}.back{border-radius:17px;background:var(--rc-surface);color:var(--rc-primary-strong);font-size:28px;line-height:31px;text-align:center}.title{font-size:19px;font-weight:700}.content{height:calc(100vh - 56px);padding:16px var(--rc-page-gutter) 32px;box-sizing:border-box}.form,.plan{margin-bottom:14px;padding:15px;border-radius:16px;background:var(--rc-surface);border:1px solid var(--rc-border)}.form-title{font-size:15px;font-weight:700}.field{min-height:40px;margin-top:9px;padding:0 11px;border-radius:10px;background:var(--rc-muted-bg);color:var(--rc-text);font-size:12px;line-height:40px;box-sizing:border-box}.meal-row{display:flex;gap:8px;margin-top:9px}.meal{flex:1;height:34px;border-radius:10px;background:var(--rc-muted-bg);color:var(--rc-text-secondary);font-size:12px;line-height:34px;text-align:center}.meal.active{background:var(--rc-primary-container);color:var(--rc-primary-strong);font-weight:700}.primary{height:42px;margin-top:11px;border-radius:12px;background:var(--rc-primary);color:var(--rc-on-primary);font-size:13px;line-height:42px}.primary::after{border:0}.plan{display:flex;gap:11px}.thumb{width:68px;height:68px;border-radius:10px;background:var(--rc-muted-bg)}.body{min-width:0;flex:1}.plan-head{display:flex;justify-content:space-between;gap:8px}.name{font-size:14px;font-weight:700}.status{color:var(--rc-primary-strong);font-size:10px}.meta,.remark{display:block;margin-top:5px;color:var(--rc-text-secondary);font-size:10px}.actions{display:flex;gap:12px;margin-top:13px;color:var(--rc-primary-strong);font-size:11px}.actions .danger{margin-left:auto;color:var(--rc-danger)}.empty{padding:46px;color:var(--rc-text-secondary);font-size:13px;text-align:center}
.plan-tabs{display:flex;gap:8px;margin-bottom:12px}.plan-tab{flex:1;height:34px;border-radius:10px;background:var(--rc-muted-bg);color:var(--rc-text-secondary);font-size:12px;line-height:34px;text-align:center}.plan-tab.active{background:var(--rc-primary-container);color:var(--rc-primary-strong);font-weight:700}.conflict{display:block;margin-top:5px;color:var(--rc-warning);font-size:10px}
