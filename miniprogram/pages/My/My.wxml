<view class="page">
  <view class="header" style="padding-top: {{topSafeHeight}}px; padding-right: {{capsuleSafeRight}}px; height: {{topSafeHeight + 64}}px;">
    <view class="header-title-group">
      <view class="title">我的</view>
      <view class="subtitle">情侣空间和个人设置</view>
    </view>
  </view>

  <view class="profile-fixed">
    <view class="profile-hero">
      <view class="profile-person">
        <image wx:if="{{profile.avatarUrl}}" class="profile-avatar" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="profile-avatar profile-avatar-fallback">{{profileInitial}}</view>
        <view class="profile-person-copy">
          <text class="profile-role">我</text>
          <text class="profile-name">{{profile.nickName || '未设置昵称'}}</text>
        </view>
      </view>
      <view class="profile-connector">+</view>
      <view class="profile-person partner-person">
        <image wx:if="{{partnerInfo.avatarUrl}}" class="profile-avatar" src="{{partnerInfo.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="profile-avatar profile-avatar-fallback muted">{{isPaired ? 'TA' : '?'}}</view>
        <view class="profile-person-copy">
          <text class="profile-role">{{isPaired ? 'TA' : '未配对'}}</text>
          <text class="profile-name">{{partnerInfo.nickName || (isPaired ? '配对对象' : '先去配对')}}</text>
        </view>
      </view>
      <view class="profile-hero-foot">
        <text>{{isPaired ? '你们已连接，可以一起管理菜单和订单' : '绑定另一半后共享点餐空间'}}</text>
        <button class="profile-edit-btn" bindtap="goProfileSetup">编辑资料</button>
      </view>
    </view>
  </view>

  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}">

    <view class="section block quick-actions">
      <view class="block-head">
        <text class="block-title">常用入口</text>
        <text class="block-desc">两列排列，快速进入</text>
      </view>
      <view class="action-grid">
        <button class="biz-action biz-secondary profile-btn" bindtap="goNotifySettings">通知设置</button>
        <button class="biz-action biz-secondary profile-btn" bindtap="goFoodPreferences">口味与忌口</button>
        <button class="biz-action biz-secondary profile-btn" bindtap="goSavedMenus">收藏与想吃</button>
        <button class="biz-action biz-secondary profile-btn" bindtap="goMealPlans">用餐计划</button>
      </view>
    </view>

    <view class="section block" wx:if="{{isAdmin}}">
      <view class="block-head">
        <text class="block-title">轮播图管理</text>
        <text class="block-desc">当前 {{banners.length}} 张</text>
      </view>
      <swiper
        wx:if="{{banners.length > 0}}"
        class="banner-swiper"
        circular="{{banners.length > 1}}"
        current="{{bannerCurrent}}"
        previous-margin="92rpx"
        next-margin="92rpx"
        duration="260"
        easing-function="easeOutCubic"
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id" wx:for-index="idx">
          <view class="banner-slide {{bannerCurrent === idx ? 'is-active' : 'is-inactive'}}">
            <image
              class="banner-thumb {{bannerCurrent === idx ? 'is-active' : 'is-inactive'}}"
              src="{{item.url}}"
              mode="aspectFit"
              lazy-load="true"
              webp
              data-url="{{item.url}}"
              bindtap="previewBanner"
            ></image>
            <view class="banner-delete" data-url="{{item.url}}" data-idx="{{idx}}" catchtap="deleteBanner">
              <text class="banner-delete-icon">×</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <button class="biz-action biz-primary banner-upload-btn" bindtap="handleUploadBanner">上传轮播图</button>
    </view>

    <view class="section block">
      <view class="block-head">
        <text class="block-title">菜品分类管理</text>
        <text class="block-desc">支持重命名与拖拽排序</text>
      </view>
      <view class="category-actions">
        <view class="add-category-btn" bindtap="addCategory">+ 新增分类</view>
      </view>
      <view class="category-list">
        <view
          wx:for="{{categoryEntries}}"
          wx:key="key"
          class="category-item {{draggingCategoryIndex === index ? 'is-dragging' : ''}} {{dragPreviewIndex === index && draggingCategoryIndex !== -1 ? 'is-preview-target' : ''}} {{draggingCategoryIndex !== -1 && dragInsertIndex > draggingCategoryIndex && index > draggingCategoryIndex && index < dragInsertIndex ? 'is-shift-up' : ''}} {{draggingCategoryIndex !== -1 && dragInsertIndex < draggingCategoryIndex && index >= dragInsertIndex && index < draggingCategoryIndex ? 'is-shift-down' : ''}}"
          style="{{draggingCategoryIndex === index ? ('transform: translateY(' + dragOffsetY + 'px);') : ''}}"
        >
          <text
            class="drag-handle"
            data-index="{{index}}"
            catchtouchstart="onCategoryDragStart"
            catchtouchmove="onCategoryDragMove"
            catchtouchend="onCategoryDragEnd"
            catchtouchcancel="onCategoryDragEnd"
          >☰</text>
          <text class="label">{{item.label}}</text>
          <view class="row-actions">
            <view class="icon-action icon-edit" data-key="{{item.key}}" bindtap="editCategory">✎</view>
            <view class="icon-action danger icon-delete" data-key="{{item.key}}" bindtap="deleteCategory">✕</view>
          </view>
        </view>
      </view>
      <view class="drag-tip">拖动左侧“☰”可调整顺序，松手即完成排序</view>
      <button class="biz-action biz-secondary reset-category-btn" bindtap="resetCategories">恢复默认分类</button>
    </view>

    <view class="section block danger-block">
      <view class="block-head">
        <text class="block-title">关联管理</text>
        <text class="block-desc">{{isPaired ? '慎重操作' : '当前未配对'}}</text>
      </view>
      <button wx:if="{{isPaired}}" class="biz-action biz-danger unbind-pair-btn" bindtap="unbindPair">解除关联</button>
      <button wx:else class="biz-action biz-primary pair-btn" bindtap="goPairing">去配对</button>
    </view>
  </scroll-view>
</view>
