page {
  background-color: var(--rc-bg);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header {
  height: 56px;
  flex-shrink: 0;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.header-right {
  min-width: 34px;
  min-height: 34px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.content {
  width: 100%;
  padding: var(--rc-scroll-top-gap) var(--rc-page-gutter) var(--rc-scroll-bottom-gap);
  box-sizing: border-box;
}

.section {
  margin-bottom: var(--rc-scroll-section-gap);
  animation: rc-scroll-enter var(--rc-scroll-enter-duration) var(--rc-ease-out) both;
}

.section:nth-child(1) { animation-delay: 30ms; }
.section:nth-child(2) { animation-delay: 70ms; }
.section:nth-child(3) { animation-delay: 110ms; }
.section:nth-child(4) { animation-delay: 150ms; }

.block {
  background: var(--rc-on-primary);
  border-radius: 16px;
  padding: 18px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  box-sizing: border-box;
  transform-origin: center;
}

.block:active {
  transform: translateY(1px) scale(0.994);
  box-shadow: 0 5px 14px rgba(57, 80, 96, 0.07);
}

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.block-title {
  font-size: 16px;
  color: var(--rc-text);
  font-weight: 600;
  letter-spacing: 0.3px;
}

.block-desc {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.banner-swiper {
  margin-top: 10px;
  width: 100%;
  height: 252rpx;
}

.banner-slide {
  position: relative;
  height: 252rpx;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  transition: transform 0.26s ease, opacity 0.26s ease;
}

.banner-slide.is-active {
  transform: translateY(-6rpx) scale(1);
  opacity: 1;
}

.banner-slide.is-inactive {
  transform: translateY(10rpx) scale(0.82);
  opacity: 0.58;
}

.banner-thumb {
  width: 100%;
  height: 240rpx;
  border-radius: 14px;
  background: var(--rc-muted-bg);
  border: none;
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  transition: filter 0.26s ease, box-shadow 0.26s ease;
}

.banner-swiper swiper-item {
  background: transparent;
}

.banner-thumb.is-active {
  filter: none;
  box-shadow: 0 7px 18px rgba(57, 80, 96, 0.08);
}

.banner-thumb.is-inactive {
  filter: blur(1.4px) saturate(0.86);
  box-shadow: 0 4px 10px rgba(45, 137, 87, 0.10);
}

.banner-delete {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(36, 55, 36, 0.44);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.banner-delete:active {
  transform: translateY(1px) scale(0.94);
}

.banner-delete-icon {
  color: var(--rc-on-primary);
  display: block;
  font-size: 28rpx;
  line-height: 52rpx;
  transform: translateY(-1rpx);
  text-align: center;
}

.banner-upload-btn {
  margin-top: 12px;
  width: 100%;
}

.category-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8px;
}

.add-category-btn {
  min-width: 88px;
  height: 28px;
  border-radius: 14px;
  padding: 0 10px;
  box-sizing: border-box;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  color: var(--rc-primary-strong);
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.category-item {
  position: relative;
  width: 100%;
  min-height: 44px;
  border-radius: 12px;
  background: var(--rc-surface-2);
  border: 1px solid var(--rc-chip-bg);
  padding: 8px 10px;
  display: flex;
  gap: 8px;
  align-items: center;
  box-sizing: border-box;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, background-color 0.22s ease;
  will-change: transform;
}

.category-item.is-dragging {
  border-color: var(--rc-primary);
  background: var(--rc-primary-container);
  box-shadow: 0 8px 18px rgba(45, 137, 87, 0.16);
  z-index: 2;
  transition: box-shadow 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
}

.category-item.is-preview-target {
  border-color: var(--rc-primary);
  box-shadow: inset 0 0 0 1px var(--rc-primary);
}

.category-item.is-shift-up {
  transform: translateY(-52px);
}

.category-item.is-shift-down {
  transform: translateY(52px);
}

.drag-handle {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  background: var(--rc-on-primary);
  border: 1px solid var(--rc-border);
  color: var(--rc-text-secondary);
  font-size: 12px;
  text-align: center;
  line-height: 20px;
  flex-shrink: 0;
}

.label {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: var(--rc-text);
  line-height: 18px;
  word-break: break-all;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.icon-edit,
.icon-delete {
  font-size: 15px;
  font-weight: 600;
}

.drag-tip {
  margin-top: 8px;
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.reset-category-btn {
  margin-top: 12px;
  width: 100%;
}

.profile-btn,
.pair-btn,
.unbind-pair-btn {
  width: 100%;
  margin-top: 2px;
}

.banner-upload-btn,
.reset-category-btn,
.profile-btn,
.pair-btn,
.unbind-pair-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.danger-block {
  border: 1px solid var(--rc-border);
  background: var(--rc-surface);
}

/* Figma Site profile/settings: soft blocks with clear dangerous action. */
.header {
  background: transparent;
  border-bottom: 0;
  box-shadow: none;
}

.title {
  font-size: 22px;
  font-weight: 900;
}

.content {
  padding-top: 8px;
  padding-bottom: 86px;
}

.section {
  margin-bottom: 12px;
}

.block {
  border-radius: 24px;
  padding: 16px;
}

.block-title {
  font-size: 15px;
  font-weight: 900;
}

.block-desc {
  font-size: 11px;
  font-weight: 750;
}

.banner-swiper {
  height: 214rpx;
}

.banner-slide,
.banner-thumb {
  height: 202rpx;
  border-radius: 22px;
}

.category-item {
  min-height: 42px;
  border-radius: 18px;
  background: var(--rc-surface-2);
}

.drag-handle {
  background: var(--rc-primary-container);
  color: var(--rc-primary-strong);
  border: 0;
  font-weight: 900;
}

.add-category-btn {
  height: 30px;
  border-radius: 999px;
  font-weight: 850;
}

.profile-btn,
.pair-btn,
.unbind-pair-btn,
.banner-upload-btn,
.reset-category-btn {
  height: 42px;
  border-radius: 999px;
}

.danger-block {
  background: var(--rc-danger-soft);
}

/* Keep the custom header clear of WeChat's right-side capsule controls. */
.profile-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 24px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
  padding: 14px !important;
  background: var(--rc-surface);
}

.profile-fixed {
  flex: 0 0 auto;
  padding: 8px var(--rc-page-gutter) 10px;
  box-sizing: border-box;
}

.profile-fixed .profile-hero {
  min-height: 128px;
  box-sizing: border-box;
}

.page > .content {
  flex: 1 1 auto;
  height: auto !important;
  min-height: 0;
}

.profile-person {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
}

.partner-person {
  justify-content: flex-end;
  text-align: right;
}

.profile-avatar {
  width: 52px;
  height: 52px;
  aspect-ratio: 1 / 1;
  flex: 0 0 52px;
  border-radius: 50%;
  object-fit: cover;
  background: var(--rc-primary-container);
  color: var(--rc-primary-strong);
  font-size: 18px;
  font-weight: 800;
  line-height: 52px;
  text-align: center;
}

.profile-avatar-fallback.muted {
  background: var(--rc-muted-bg);
  color: var(--rc-text-tertiary);
}

.profile-person-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.profile-role {
  color: var(--rc-text-secondary);
  font-size: 11px;
  line-height: 1.2;
}

.profile-name {
  max-width: 120px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--rc-text);
  font-size: 15px;
  font-weight: 800;
}

.profile-connector {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--rc-primary-container);
  color: var(--rc-primary-strong);
  font-size: 17px;
  font-weight: 700;
  line-height: 24px;
  text-align: center;
}

.profile-hero-foot {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--rc-hairline);
  color: var(--rc-text-secondary);
  font-size: 11px;
  line-height: 1.4;
}

.profile-edit-btn {
  flex: 0 0 auto;
  min-height: 32px;
  padding: 0 12px;
  border: 1px solid var(--rc-hairline);
  border-radius: 16px;
  background: var(--rc-accent-container);
  color: var(--rc-accent-strong);
  font-size: 12px;
  line-height: 32px;
}

.quick-actions {
  min-height: 188px;
  padding-bottom: 14px !important;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.action-grid .profile-btn {
  width: 100%;
  min-width: 0;
  margin: 0;
  min-height: 58px;
  padding: 0 8px;
  border-radius: 12px;
  font-size: 12px;
  white-space: nowrap;
}

.content > .section.block {
  min-height: 168px;
}

.content > .section.block.quick-actions {
  min-height: 188px;
}

.content > .section.block.danger-block {
  min-height: 132px;
}

@media (max-width: 360px) {
  .profile-avatar {
    width: 44px;
    height: 44px;
    flex-basis: 44px;
    line-height: 44px;
  }

  .profile-name {
    max-width: 84px;
    font-size: 13px;
  }

  .profile-hero-foot {
    align-items: flex-start;
    flex-direction: column;
  }

  .profile-edit-btn {
    width: 100%;
  }

  .profile-fixed .profile-hero {
    min-height: 164px;
  }
}

/* Separate profile, section headings and actions without enlarging fixed areas. */
.section { margin-bottom: var(--rc-scroll-section-gap); }
.action-grid { gap: 16px; }
.block-head { margin-bottom: 16px; }
.profile-hero-foot { gap: 12px; flex-wrap: wrap; }
