page {
  background-color: var(--rc-bg);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header {
  height: 56px;
  flex-shrink: 0;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.header-right {
  min-width: 34px;
  min-height: 34px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.content {
  width: 100%;
  padding: var(--rc-scroll-top-gap) var(--rc-page-gutter) var(--rc-scroll-bottom-gap);
  box-sizing: border-box;
}

.section {
  margin-bottom: var(--rc-scroll-section-gap);
  animation: rc-scroll-enter var(--rc-scroll-enter-duration) var(--rc-ease-out) both;
}

.section:nth-child(1) { animation-delay: 30ms; }
.section:nth-child(2) { animation-delay: 70ms; }
.section:nth-child(3) { animation-delay: 110ms; }
.section:nth-child(4) { animation-delay: 150ms; }

.block {
  background: var(--rc-on-primary);
  border-radius: 16px;
  padding: 18px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  box-sizing: border-box;
  transform-origin: center;
}

.block:active {
  transform: translateY(1px) scale(0.994);
  box-shadow: 0 5px 14px rgba(57, 80, 96, 0.07);
}

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.block-title {
  font-size: 16px;
  color: var(--rc-text);
  font-weight: 600;
  letter-spacing: 0.3px;
}

.block-desc {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.banner-swiper {
  margin-top: 10px;
  width: 100%;
  height: 252rpx;
}

.banner-slide {
  position: relative;
  height: 252rpx;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  transition: transform 0.26s ease, opacity 0.26s ease;
}

.banner-slide.is-active {
  transform: translateY(-6rpx) scale(1);
  opacity: 1;
}

.banner-slide.is-inactive {
  transform: translateY(10rpx) scale(0.82);
  opacity: 0.58;
}

.banner-thumb {
  width: 100%;
  height: 240rpx;
  border-radius: 14px;
  background: transparent;
  border: none;
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  transition: filter 0.26s ease, box-shadow 0.26s ease;
}

.banner-swiper swiper-item {
  background: transparent;
}

.banner-thumb.is-active {
  filter: none;
  box-shadow: 0 7px 18px rgba(57, 80, 96, 0.08);
}

.banner-thumb.is-inactive {
  filter: blur(1.4px) saturate(0.86);
  box-shadow: 0 4px 10px rgba(138, 197, 138, 0.10);
}

.banner-delete {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(36, 55, 36, 0.44);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.banner-delete:active {
  transform: translateY(1px) scale(0.94);
}

.banner-delete-icon {
  color: var(--rc-on-primary);
  display: block;
  font-size: 28rpx;
  line-height: 52rpx;
  transform: translateY(-1rpx);
  text-align: center;
}

.banner-upload-btn {
  margin-top: 12px;
  width: 100%;
}

.category-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8px;
}

.add-category-btn {
  min-width: 88px;
  height: 28px;
  border-radius: 14px;
  padding: 0 10px;
  box-sizing: border-box;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  color: var(--rc-primary-strong);
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.category-item {
  position: relative;
  width: 100%;
  min-height: 44px;
  border-radius: 12px;
  background: var(--rc-surface-2);
  border: 1px solid var(--rc-chip-bg);
  padding: 8px 10px;
  display: flex;
  gap: 8px;
  align-items: center;
  box-sizing: border-box;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, background-color 0.22s ease;
  will-change: transform;
}

.category-item.is-dragging {
  border-color: var(--rc-primary);
  background: var(--rc-primary-container);
  box-shadow: 0 8px 18px rgba(160, 214, 160, 0.16);
  z-index: 2;
  transition: box-shadow 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
}

.category-item.is-preview-target {
  border-color: var(--rc-primary);
  box-shadow: inset 0 0 0 1px var(--rc-primary);
}

.category-item.is-shift-up {
  transform: translateY(-52px);
}

.category-item.is-shift-down {
  transform: translateY(52px);
}

.drag-handle {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  background: var(--rc-on-primary);
  border: 1px solid var(--rc-border);
  color: var(--rc-text-secondary);
  font-size: 12px;
  text-align: center;
  line-height: 20px;
  flex-shrink: 0;
}

.label {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: var(--rc-text);
  line-height: 18px;
  word-break: break-all;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.icon-edit,
.icon-delete {
  font-size: 15px;
  font-weight: 600;
}

.drag-tip {
  margin-top: 8px;
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.reset-category-btn {
  margin-top: 12px;
  width: 100%;
}

.profile-btn,
.pair-btn,
.unbind-pair-btn {
  width: 100%;
  margin-top: 2px;
}

.banner-upload-btn,
.reset-category-btn,
.profile-btn,
.pair-btn,
.unbind-pair-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.danger-block {
  border: 1px solid var(--rc-border);
  background: var(--rc-surface);
}
