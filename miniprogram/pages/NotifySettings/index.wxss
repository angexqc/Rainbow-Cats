page {
  background-color: var(--rc-bg);
}

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  height: 56px;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.back-btn,
.header-space {
  width: 34px;
  text-align: center;
  font-size: 20px;
  color: var(--rc-text);
}

.back-btn {
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.back-btn:active {
  transform: translateY(1px) scale(0.92);
  opacity: 0.8;
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 14px var(--rc-page-gutter) calc(16px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: notify-enter var(--rc-motion-medium) var(--rc-ease-out) both;
}

.block {
  background: var(--rc-on-primary);
  border-radius: 16px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  padding: 14px;
  margin-bottom: 12px;
  transition: transform var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out);
}

.block:active {
  transform: translateY(1px) scale(0.995);
  box-shadow: 0 8px 18px rgba(138, 197, 138, 0.12);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.label {
  font-size: 15px;
  color: var(--rc-text);
  font-weight: 600;
}

.desc {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.status-row {
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.input-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 8px;
}

.template-input {
  height: 36px;
  line-height: 36px;
  border: 1px solid var(--rc-border);
  border-radius: 10px;
  padding: 0 10px;
  font-size: 13px;
  color: var(--rc-text);
  background: var(--rc-on-primary);
  transition: border-color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), background-color var(--rc-motion-fast) var(--rc-ease-out);
}

.template-input:active {
  border-color: var(--rc-primary);
  box-shadow: 0 0 0 3px rgba(160, 214, 160, 0.15);
  background: var(--rc-surface);
}

.template-preview {
  margin-top: 8px;
  padding: 8px 10px;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  border-radius: 10px;
}

.preview-line {
  display: block;
  font-size: 12px;
  color: var(--rc-text-secondary);
  line-height: 1.5;
  margin-bottom: 4px;
  word-break: break-all;
}

.status-label {
  font-size: 13px;
  color: var(--rc-text-secondary);
}

.status-value {
  font-size: 13px;
  font-weight: 600;
}

.status-value.on {
  color: var(--rc-success);
  animation: notify-status-pulse 1.8s var(--rc-ease-in-out) infinite;
}

.status-value.off {
  color: var(--rc-text-secondary);
}

.btn {
  margin-top: 10px;
  height: 38px;
  border-radius: 19px;
  background: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), box-shadow var(--rc-motion-fast) var(--rc-ease-out), opacity var(--rc-motion-fast) var(--rc-ease-out), background-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out);
}

.btn:active {
  transform: translateY(1px) scale(0.98);
}

.btn::after {
  border: none;
}

.btn.ghost {
  background: var(--rc-primary-container);
  color: var(--rc-primary-strong);
  border: 1px solid var(--rc-border);
}

.loading {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(242, 248, 242, 0.84);
  backdrop-filter: none;
  animation: notify-loading-fade var(--rc-motion-fast) var(--rc-ease-out) both;
}

.loading-panel {
  width: 134px;
  height: 134px;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(223, 245, 233, 0.96);
  box-shadow: 0 8px 20px rgba(57, 80, 96, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes notify-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes notify-loading-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes notify-status-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}
