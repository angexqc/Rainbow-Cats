page {
  background: radial-gradient(circle at 22% 14%, var(--rc-surface) 0%, var(--rc-bg) 34%, var(--rc-bg-elevated) 100%);
}

.page {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 1;
  transform: translateY(0);
  transition: opacity var(--rc-motion-fast) var(--rc-ease-out), transform var(--rc-motion-fast) var(--rc-ease-out);
}

.center-box.is-exiting {
  opacity: 0.62;
  transform: translateY(-4px);
}

.lottie-canvas {
  width: 220px;
  height: 220px;
}

.title {
  margin-top: 10px;
  font-size: 28px;
  font-weight: 700;
  color: var(--rc-primary-strong);
  letter-spacing: 1.4px;
  font-family: var(--rc-font-display);
  animation: splash-title-rise var(--rc-motion-medium) var(--rc-ease-out) both;
}

@keyframes splash-title-rise {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fallback-tip {
  margin-top: 8px;
  font-size: 11px;
  color: var(--rc-text-secondary);
}

.fallback-dot-wrap {
  width: 90px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dot {
  width: 14px;
  height: 14px;
  border-radius: 7px;
  background: var(--rc-primary);
  animation: splash-dot 1.2s ease-in-out infinite;
}

.dot-2 {
  animation-delay: 0.15s;
}

.dot-3 {
  animation-delay: 0.3s;
}

@keyframes splash-dot {
  0%, 100% {
    opacity: 0.35;
    transform: translateY(3px) scale(0.8);
  }
  50% {
    opacity: 1;
    transform: translateY(-3px) scale(1);
  }
}
