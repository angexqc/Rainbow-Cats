page {
  background: var(--rc-bg);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  height: 56px;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 14px var(--rc-page-gutter) calc(16px + env(safe-area-inset-bottom));
}

.tip {
  font-size: 13px;
  color: var(--rc-text-secondary);
  margin-bottom: 16px;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 18px 0;
  background: var(--rc-surface);
  border-radius: 12px;
}

.avatar {
  width: 84px;
  height: 84px;
  border-radius: 42px;
  background: var(--rc-surface-2);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--rc-text-secondary);
  font-size: 12px;
}

.ghost {
  width: 220px;
  height: 36px;
  line-height: 36px;
  border-radius: 18px;
  border: 1px solid var(--rc-border);
  color: var(--rc-text-secondary);
  background: var(--rc-on-primary);
  font-size: 13px;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost::after {
  border: none;
}

.form-item {
  margin-top: 14px;
  background: var(--rc-surface);
  border-radius: 12px;
  padding: 14px;
}

.label {
  display: block;
  font-size: 13px;
  color: var(--rc-text-secondary);
  margin-bottom: 8px;
}

.input {
  height: 42px;
  border: 1px solid var(--rc-border);
  border-radius: 10px;
  padding: 0 12px;
  font-size: 15px;
  color: var(--rc-text);
  background: var(--rc-on-primary);
}

.save {
  margin-top: 18px;
  height: 44px;
  line-height: 44px;
  border-radius: 10px;
  background: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 15px;
  font-weight: 500;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save::after {
  border: none;
}
