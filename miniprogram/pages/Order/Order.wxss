page {
  background-color: var(--rc-bg);
}

.page {
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header {
  height: 56px;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 34px;
  min-width: 0;
  flex-shrink: 1;
}

.header-wheel,
.header-delete {
  width: 34px;
  height: 34px;
  border-radius: 17px;
  background: linear-gradient(180deg, var(--rc-surface) 0%, var(--rc-surface-2) 100%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), box-shadow var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), background-color var(--rc-motion-fast) var(--rc-ease-out);
}

.header-wheel {
  position: relative;
  border: 1px solid var(--rc-primary-container);
  color: var(--rc-primary-strong);
}

.header-wheel-dial {
  position: relative;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: conic-gradient(from -90deg, var(--rc-primary) 0deg 120deg, #bfe7cf 120deg 240deg, #8fd1c1 240deg 360deg);
  box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.72);
}

.header-wheel-dial::after {
  content: '';
  position: absolute;
  left: 7px;
  top: 7px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
}

.header-wheel-dot {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
}

.header-wheel-dot.dot-a {
  top: 4px;
  left: 9px;
}

.header-wheel-dot.dot-b {
  right: 4px;
  bottom: 6px;
}

.header-wheel-dot.dot-c {
  left: 4px;
  bottom: 6px;
}

.header-wheel-pointer {
  position: absolute;
  top: 5px;
  left: 50%;
  width: 0;
  height: 0;
  margin-left: -4px;
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-top: 7px solid var(--rc-primary-strong);
  filter: drop-shadow(0 1px 1px rgba(45, 137, 87, 0.20));
}

.header-delete {
  border: 1px solid rgba(226, 85, 111, 0.18);
  color: var(--rc-danger);
  font-size: 16px;
}

.header-wheel:active,
.header-delete:active {
  transform: translateY(1px) scale(0.95);
}

.content {
  padding: var(--rc-scroll-top-gap) var(--rc-page-gutter) 0;
  box-sizing: border-box;
}

.content.has-bottom-bar {
  padding-bottom: var(--rc-scroll-bottom-gap);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.toolbar-text {
  font-size: 13px;
  color: var(--rc-text-secondary);
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.toolbar-actions .icon-action {
  width: 30px;
  min-width: 30px;
  height: 30px;
  padding: 0;
  border-radius: 15px;
  font-size: 14px;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.cart-item {
  background: var(--rc-surface);
  border-radius: 16px;
  padding: 16px 14px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  display: flex;
  align-items: center;
  gap: 10px;
  position: relative;
  overflow: hidden;
  transform-origin: center;
}

.cart-item:active {
  transform: translateY(1px) scale(0.993);
  box-shadow: 0 5px 14px rgba(57, 80, 96, 0.07);
}

.category-flag {
  position: absolute;
  top: 0;
  right: 0;
  height: 22px;
  padding: 0 10px 0 12px;
  border-radius: 0 16px 0 16px;
  background: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 11px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.check {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  border: 1px solid var(--rc-border-strong);
  color: transparent;
  line-height: 22px;
  text-align: center;
  font-size: 13px;
}

.check.checked {
  background: var(--rc-primary);
  border-color: var(--rc-primary);
  color: var(--rc-on-primary);
  box-shadow: 0 6px 14px rgba(45, 137, 87, 0.16);
}

.thumb {
  width: 72px;
  height: 72px;
  border-radius: 10px;
  background: var(--rc-muted-bg);
}

.info {
  flex: 1;
}

.name {
  font-size: 15px;
  color: var(--rc-text);
  font-weight: 600;
}

.item-actions {
  margin-top: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.qty-btn {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: var(--rc-surface-2);
  color: var(--rc-primary);
  font-size: 16px;
  line-height: 24px;
  text-align: center;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out);
}

.qty-btn:active {
  transform: translateY(1px) scale(0.94);
}

.quantity {
  min-width: 18px;
  text-align: center;
  font-size: 13px;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: var(--rc-bottom-bar-height);
  background: var(--rc-surface-glass);
  border-top: 1px solid var(--rc-border);
  padding: 0 var(--rc-page-gutter) var(--rc-safe-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: 0 -6px 16px rgba(57, 80, 96, 0.06);
  transition: box-shadow var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), background-color var(--rc-motion-fast) var(--rc-ease-out);
}

.summary {
  font-size: 14px;
  color: var(--rc-text);
  font-weight: 500;
}

.submit-btn {
  min-width: 96px;
  padding: 0 24px;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 var(--rc-page-gutter) var(--rc-scroll-bottom-gap);
  animation: rc-scroll-enter 320ms var(--rc-ease-out) both;
}

.empty-title {
  font-size: 16px;
  color: var(--rc-text);
}

.empty-desc {
  margin-top: 6px;
  font-size: 13px;
  color: var(--rc-text-secondary);
}

/* Figma Site cart: airy compact list with floating submit bar. */
.header {
  background: transparent;
  border-bottom: 0;
  box-shadow: none;
}

.title {
