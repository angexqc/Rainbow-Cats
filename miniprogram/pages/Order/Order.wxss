}

.empty-title {
  font-size: 18px;
  font-weight: 900;
}

.header {
  padding-left: var(--rc-page-gutter);
  justify-content: space-between;
}
.header-title-group { flex: 0 0 auto; }
.header-right { margin-left: auto; }
.header-title-group,
.header-right { transform: translateY(8px); }
