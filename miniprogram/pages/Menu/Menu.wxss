page {
  background-color: var(--rc-bg);
}

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header {
  height: 56px;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 34px;
}


.history-mini,
.cart-mini,
.add-icon {
  width: 34px;
  height: 34px;
  border-radius: 17px;
  box-sizing: border-box;
}

.history-mini,
.cart-mini {
  background: linear-gradient(180deg, var(--rc-surface) 0%, var(--rc-surface-2) 100%);
  border: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-mini {
  position: relative;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), box-shadow var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out);
}

.history-mini-icon,
.cart-mini-icon,
.add-icon {
  font-size: 17px;
  line-height: 1;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.history-mini-icon {
  width: 17px;
  height: 17px;
}

.calendar-icon {
  position: relative;
  width: 16px;
  height: 16px;
  border: 1.6px solid var(--rc-text-secondary);
  border-radius: 4px;
  box-sizing: border-box;
  background: transparent;
}

.calendar-bar {
  position: absolute;
  left: -1px;
  right: -1px;
  top: -1px;
  height: 4px;
  border-radius: 4px 4px 2px 2px;
  background: var(--rc-primary);
}

.calendar-rings {
  position: absolute;
  top: -2px;
  left: 3px;
  right: 3px;
  display: flex;
  justify-content: space-between;
}

.calendar-ring {
  width: 2px;
  height: 4px;
  border-radius: 999px;
  background: var(--rc-surface);
}

.calendar-grid {
  position: absolute;
  left: 3px;
  right: 3px;
  bottom: 3px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2px;
}

.calendar-dot {
  width: 3px;
  height: 3px;
  border-radius: 999px;
  background: rgba(93, 123, 95, 0.82);
  justify-self: center;
}

.mini-count {
  position: absolute;
  top: -6px;
  right: -6px;
  min-width: 16px;
  height: 16px;
  padding: 0 3px;
  border-radius: 8px;
  background: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 10px;
  line-height: 16px;
  text-align: center;
}

.add-icon {
  padding: 0;
}

.content {
  width: 100%;
  padding: var(--rc-scroll-top-gap) var(--rc-page-gutter) 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.top-fixed {
  flex-shrink: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.search-bar {
  height: 42px;
  border-radius: 18px;
  border: 1px solid var(--rc-border);
  background-color: var(--rc-surface-glass);
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 6px 14px rgba(138, 197, 138, 0.08);
  transition: border-color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), transform var(--rc-motion-fast) var(--rc-ease-out);
}

.search-icon {
  font-size: 14px;
  color: var(--rc-text-secondary);
}

.search-input {
  flex: 1;
  height: 40px;
  font-size: 14px;
  color: var(--rc-text);
}

.placeholder {
  color: var(--rc-text-secondary);
}

.category-scroll {
  margin: 12px 0 10px;
  width: 100%;
  white-space: nowrap;
  -webkit-mask-image: none;
  mask-image: none;
}

.category-filters {
  display: inline-flex;
  gap: 8px;
  padding-right: 8px;
}

.owner-scroll {
  margin: 0 0 10px;
  width: 100%;
  white-space: nowrap;
  -webkit-mask-image: none;
  mask-image: none;
}

.owner-filters {
  display: inline-flex;
  gap: 8px;
  padding-right: 8px;
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: var(--rc-scroll-bottom-gap);
}

.chip {
  height: 32px;
  padding: 0 12px;
  border-radius: 16px;
  background-color: var(--rc-chip-bg);
  border: 1px solid rgba(191, 225, 208, 0.72);
  color: var(--rc-text-secondary);
  font-size: 14px;
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.chip.active {
  background-color: var(--rc-primary);
  border-color: var(--rc-primary);
  color: var(--rc-on-primary);
  box-shadow: 0 6px 14px rgba(160, 214, 160, 0.20);
}

.chip-owner {
  height: 28px;
  padding: 0 12px;
  border-radius: 14px;
  font-size: 12px;
}

.menu-item {
  background-color: var(--rc-surface);
  border-radius: 16px;
  padding: 16px 14px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  transform-origin: center;
}

.menu-item:active {
  transform: translateY(1px) scale(0.992);
  box-shadow: 0 5px 14px rgba(57, 80, 96, 0.07);
}

.menu-item-inner {
  display: flex;
  gap: 12px;
}

.thumb {
  width: 84px;
  height: 84px;
  border-radius: 10px;
  background-color: var(--rc-bg);
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.row-top,
.row-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-top {
  gap: 8px;
}

.name {
  font-size: 16px;
  font-weight: 600;
  color: var(--rc-text);
}

.category-flag {
  max-width: 106px;
  height: 20px;
  padding: 0 8px;
  border-radius: 10px;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  color: var(--rc-primary-strong);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  justify-content: space-between;
  min-width: 0;
  width: 100%;
}

.owner-box {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  max-width: calc(100% - 94px);
  min-width: 0;
}

.owner-avatar {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  background: var(--rc-chip-bg);
}

.owner-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: var(--rc-text-secondary);
}

.owner-name {
  font-size: 12px;
  color: var(--rc-text-secondary);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-btn {
  width: 86px;
  height: 26px;
  border-radius: 13px;
  padding: 0;
  font-size: 12px;
  color: var(--rc-on-primary);
  background: var(--rc-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), box-shadow var(--rc-motion-fast) var(--rc-ease-out), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.qty-inline {
  width: 86px;
  height: 26px;
  border-radius: 14px;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  padding: 0 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-op {
  width: 18px;
  height: 18px;
  border-radius: 10px;
  background: var(--rc-on-primary);
  color: var(--rc-primary-strong);
  font-size: 14px;
  line-height: 18px;
  text-align: center;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out);
}

.qty-val {
  min-width: 18px;
  text-align: center;
  font-size: 12px;
  color: var(--rc-primary-strong);
  font-weight: 600;
}

.empty-state {
  padding: 72px 0 var(--rc-scroll-bottom-gap);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: rc-scroll-enter 320ms var(--rc-ease-out) both;
}

.empty-state text {
  font-size: 14px;
  color: var(--rc-text-secondary);
  margin-bottom: 14px;
}

.add-btn {
  height: 40px;
  line-height: 40px;
  border-radius: var(--rc-radius-field);
  background-color: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 14px;
  padding: 0 28px;
}

.load-more {
  text-align: center;
  color: var(--rc-text-secondary);
  font-size: 12px;
  padding: 16px 0 4px;
  animation: rc-scroll-enter 220ms var(--rc-ease-out) both;
}

.initial-loading {
  min-height: 36vh;
  padding: 18px 0 36px;
}

.cat-inline-loader {
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-panel {
  width: 136px;
  height: 136px;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(223, 245, 233, 0.96);
  box-shadow: 0 8px 20px rgba(57, 80, 96, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-loading {
  position: absolute;
  inset: 0;
  z-index: 40;
  background: rgba(242, 248, 242, 0.88);
  backdrop-filter: none;
  animation: menu-page-loading-in var(--rc-motion-fast) var(--rc-ease-out) both;
}

@keyframes menu-page-loading-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
