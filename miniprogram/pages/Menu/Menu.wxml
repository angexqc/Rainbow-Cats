<view class="page">
  <view class="header" style="padding-top: {{topSafeHeight}}px; padding-right: {{capsuleSafeRight}}px; height: {{topSafeHeight + 64}}px;">
    <view class="header-title-group">
      <view class="title">菜单</view>
      <view class="subtitle">轻量卡片，两列一屏看更多</view>
    </view>
    <view class="header-right">
      <view class="history-mini" bindtap="goMenuHistory">
        <view class="history-mini-icon" aria-label="历史日历">
          <view class="calendar-icon">
            <view class="calendar-bar"></view>
            <view class="calendar-rings">
              <view class="calendar-ring"></view>
              <view class="calendar-ring"></view>
            </view>
            <view class="calendar-grid">
              <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="calendar-dot"></view>
            </view>
          </view>
        </view>
      </view>
      <view class="cart-mini" bindtap="goOrder">
        <text class="cart-mini-icon">🧺</text>
        <view wx:if="{{cartCount > 0}}" class="mini-count">{{cartCount}}</view>
        <view wx:if="{{unconfirmedCount > 0}}" class="order-badge">{{unconfirmedCount}}</view>
      </view>
      <view class="candidate-mini" bindtap="goCandidates">
        <text class="candidate-mini-icon">♡</text>
        <view wx:if="{{isPaired}}" class="candidate-mini-dot"></view>
      </view>
      <view class="icon-action primary add-icon" bindtap="handleAdd">＋</view>
    </view>
  </view>

  <view class="content" style="height: {{contentHeight}}px;">
    <view class="top-fixed">
      <view class="search-bar">
        <input
          class="search-input"
          type="text"
          placeholder="搜菜品、分类、创建人"
          placeholder-class="placeholder"
          bindinput="onSearchInput"
          value="{{keyword}}"
        />
      </view>

      <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="category-filters">
          <view class="chip {{currentCategory === '' ? 'active' : ''}}" bindtap="filterCategory" data-category="">全部</view>
          <view wx:for="{{categoryList}}" wx:key="key" class="chip {{currentCategory === item.key ? 'active' : ''}}" bindtap="filterCategory" data-category="{{item.key}}">{{item.label}}</view>
        </view>
      </scroll-view>

      <scroll-view wx:if="{{isPaired}}" class="owner-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="owner-filters">
          <view
            wx:for="{{ownerFilters}}"
            wx:key="key"
            class="chip chip-owner {{ownerFilter === item.key ? 'active' : ''}}"
            bindtap="filterOwner"
            data-owner="{{item.key}}"
          >{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="shared-hint" wx:if="{{isPaired}}">
        <view class="shared-hint-dot"></view>
        <text>和 TA 一起挑，选好后再一起确认这顿饭</text>
      </view>
    </view>

    <scroll-view
      class="list-scroll"
      scroll-y
      lower-threshold="100"
      refresher-enabled
      refresher-triggered="{{refresherTriggered}}"
      bindrefresherrefresh="onListRefresh"
      bindscrolltolower="onListScrollToLower"
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="menu-list">
        <view wx:for="{{menuList}}" wx:key="_id" class="menu-item" bindtap="onMenuTap" data-id="{{item._id}}">
          <view class="menu-item-inner">
            <image class="thumb" src="{{item.image}}" mode="aspectFill" lazy-load="true" webp></image>
            <view class="info">
              <view class="row-top">
                <text class="name">{{item.title}}</text>
                <text class="category-flag">{{item.categoryDisplay || categoryMap[item.category] || item.category || '未分类'}}</text>
              </view>
              <view class="row-bottom">
                <view class="row-actions">
                  <view class="owner-box">
                    <image wx:if="{{item.ownerDisplayAvatar}}" class="owner-avatar" src="{{item.ownerDisplayAvatar}}" mode="aspectFill" lazy-load="true" webp></image>
                    <view wx:else class="owner-avatar owner-avatar-fallback">{{item.ownerDisplayName.slice(0,1)}}</view>
                    <text class="owner-name">{{item.ownerDisplayName}}</text>
                  </view>
                  <view class="mark-actions">
                    <view class="mark-btn {{favoriteMap[item._id] ? 'active' : ''}}" catchtap="toggleMenuMark" data-kind="favorite" data-id="{{item._id}}">{{favoriteMap[item._id] ? '♥' : '♡'}}</view>
                    <view class="mark-btn {{wishMap[item._id] ? 'active' : ''}}" catchtap="toggleMenuMark" data-kind="wish" data-id="{{item._id}}">想吃</view>
                  </view>
                  <view class="candidate-btn" catchtap="addToCandidate" data-id="{{item._id}}">加入候选</view>
                  <view wx:if="{{cartMap[item._id] && cartMap[item._id].count > 0}}" class="qty-inline">
                    <view class="qty-op" catchtap="cancelOrderItem" data-id="{{item._id}}">-</view>
                    <text class="qty-val">{{cartMap[item._id].count}}</text>
                    <view class="qty-op" catchtap="addToCart" data-id="{{item._id}}">+</view>
                  </view>
                  <view wx:else class="order-btn" catchtap="addToCart" data-id="{{item._id}}">下单</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{!pageLoading && menuList.length === 0 && !loading}}" class="empty-state">
        <text>暂无菜品，快来添加吧</text>
        <button class="add-btn" bindtap="handleAdd">添加菜品</button>
      </view>
      <view wx:if="{{!pageLoading && loading && menuList.length === 0}}" class="initial-loading cat-inline-loader">
        <view class="loading-panel">
          <cat-lottie-loader size="{{74}}"></cat-lottie-loader>
        </view>
      </view>

      <view wx:if="{{!pageLoading && loading && menuList.length > 0}}" class="load-more cat-inline-loader">
        <cat-lottie-loader size="{{30}}"></cat-lottie-loader>
      </view>
      <view wx:if="{{!pageLoading && hasMore && !loading && menuList.length > 0}}" class="load-more">上拉加载更多...</view>
      <view wx:if="{{!pageLoading && !hasMore && menuList.length > 0}}" class="load-more">已加载全部</view>
    </scroll-view>
  </view>

  <view wx:if="{{pageLoading}}" class="page-loading cat-loader">
    <view class="loading-panel">
      <cat-lottie-loader size="{{92}}"></cat-lottie-loader>
    </view>
  </view>
</view>
