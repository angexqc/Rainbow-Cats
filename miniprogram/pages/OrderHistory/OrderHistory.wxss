page {
  background-color: var(--rc-bg);
}

.page {
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header {
  height: 56px;
  padding: 0 var(--rc-page-gutter);
  box-sizing: border-box;
  background-color: var(--rc-surface-glass);
  border-bottom: 1px solid var(--rc-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(2px);
  box-shadow: var(--rc-shadow-nav);
}

.title {
  font-size: 19px;
  font-weight: 600;
  color: var(--rc-text);
  letter-spacing: 0.6px;
}

.content {
  width: 100%;
  padding: var(--rc-scroll-top-gap) var(--rc-page-gutter) var(--rc-scroll-bottom-gap);
  box-sizing: border-box;
}

.header-right {
  width: 34px;
}

.status-tabs {
  margin-bottom: 16px;
  display: flex;
  gap: 8px;
  overflow-x: auto;
  white-space: nowrap;
  background: transparent;
  border: 0;
  box-shadow: none;
  -webkit-mask-image: none;
  mask-image: none;
}

.chip {
  height: 32px;
  padding: 0 12px;
  border-radius: 16px;
  background-color: var(--rc-chip-bg);
  border: 1px solid rgba(191, 225, 208, 0.72);
  color: var(--rc-text-secondary);
  font-size: 14px;
  display: flex;
  align-items: center;
}

.chip.active {
  background-color: var(--rc-primary);
  border-color: var(--rc-primary);
  color: var(--rc-on-primary);
  box-shadow: 0 6px 14px rgba(160, 214, 160, 0.20);
}

.chip:active {
  transform: translateY(1px) scale(0.96);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.order-item {
  background-color: var(--rc-surface);
  border-radius: 16px;
  padding: 13px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
  animation: rc-scroll-enter var(--rc-scroll-enter-duration) var(--rc-ease-out) both;
  transform-origin: center;
}

.order-item:nth-child(1) { animation-delay: 20ms; }
.order-item:nth-child(2) { animation-delay: 60ms; }
.order-item:nth-child(3) { animation-delay: 100ms; }
.order-item:nth-child(4) { animation-delay: 140ms; }
.order-item:nth-child(5) { animation-delay: 180ms; }

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-time {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.divider {
  margin: 10px 0;
  height: 1px;
  background-color: var(--rc-border);
}

.status-tag {
  border-radius: 10px;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 600;
}

.status-tag.status-pending {
  background-color: var(--rc-warning-bg);
  color: var(--rc-warning);
}

.status-tag.status-confirmed {
  background-color: var(--rc-primary-container);
  color: var(--rc-primary-strong);
}

.status-tag.status-completed {
  background-color: var(--rc-success-bg);
  color: var(--rc-success);
}

.status-tag.status-cancelled {
  background-color: var(--rc-muted-bg);
  color: var(--rc-muted);
}

.order-items {
  font-size: 14px;
  color: var(--rc-text);
  line-height: 1.5;
}

.timeline-flow {
  margin-top: 10px;
  padding: 11px 12px;
  border-radius: 10px;
  background: var(--rc-surface-2);
  border: 1px solid rgba(191, 225, 208, 0.64);
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.flow-node {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.flow-node.single {
  align-items: center;
}

.flow-left {
  width: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 28px;
}

.flow-point {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--rc-border-strong);
  margin-top: 3px;
  border: 1px solid rgba(255, 255, 255, 0.55);
}

.flow-node.single .flow-left {
  min-height: 16px;
  justify-content: center;
}

.flow-node.single .flow-point {
  margin-top: 0;
}

.flow-texts {
  flex: 1;
  min-width: 0;
}

.flow-title {
  font-size: 13px;
  color: var(--rc-text);
  line-height: 1.25;
  flex-shrink: 0;
}

.flow-meta {
  font-size: 11px;
  color: var(--rc-text-secondary);
  line-height: 1.3;
}

.flow-meta.time {
  color: var(--rc-text-tertiary);
  flex-shrink: 0;
}

.flow-row {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.flow-actor-time {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.flow-meta.actor-name {
  max-width: 88px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actor-avatar {
  width: 16px;
  height: 16px;
  border-radius: 8px;
  background: var(--rc-muted-bg);
  flex-shrink: 0;
}

.actor-avatar-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
  color: var(--rc-text-secondary);
}

.flow-line {
  margin-top: 5px;
  width: 1px;
  flex: 1;
  min-height: 16px;
  background: var(--rc-border-strong);
}

.flow-point.active {
  background: var(--rc-primary);
}

.order-footer {
  margin-top: 10px;
  display: flex;
  justify-content: flex-end;
}

.order-credit {
  font-size: 14px;
  font-weight: 500;
  color: var(--rc-text);
}

.feedback-row {
  margin-top: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.like-icon-btn {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  border: 1px solid var(--rc-border);
  background: var(--rc-on-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(138, 197, 138, 0.08);
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out);
}

.like-icon-btn.active {
  border-color: var(--rc-border);
  background: var(--rc-primary-container);
}

.like-icon {
  font-size: 15px;
  color: var(--rc-text-tertiary);
  line-height: 1;
}

.like-icon-btn.active .like-icon {
  color: var(--rc-primary-strong);
}

.feedback-btn {
  min-width: 68px;
  height: 30px;
  padding: 0 10px;
  border-radius: 15px;
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--rc-border);
  color: var(--rc-text-secondary);
  background: var(--rc-on-primary);
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out);
}

.like-icon-btn:active,
.feedback-btn:active {
  transform: translateY(1px) scale(0.95);
}

.feedback-btn.review-btn {
  color: var(--rc-primary-strong);
  border-color: var(--rc-border);
  background: var(--rc-on-primary);
}

.review-box {
  margin-top: 10px;
  padding: 9px 11px;
  border-radius: 10px;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
}

.review-label {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.review-text {
  font-size: 12px;
  color: var(--rc-text);
  line-height: 1.5;
}

.empty-state {
  text-align: center;
  color: var(--rc-text-secondary);
  font-size: 14px;
  padding: 72px 0 var(--rc-scroll-bottom-gap);
  animation: rc-scroll-enter 320ms var(--rc-ease-out) both;
}

.load-more {
  text-align: center;
  color: var(--rc-text-secondary);
  font-size: 12px;
  padding: 14px 0 0;
  animation: rc-scroll-enter 220ms var(--rc-ease-out) both;
}

.initial-loading {
  min-height: 36vh;
  padding: 18px 0 36px;
}

.cat-inline-loader {
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-panel {
  width: 136px;
  height: 136px;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(223, 245, 233, 0.96);
  box-shadow: 0 8px 20px rgba(57, 80, 96, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
