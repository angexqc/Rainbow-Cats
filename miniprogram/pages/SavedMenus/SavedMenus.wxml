<view class="page"><view class="header" style="padding-top:{{topSafeHeight}}px;height:{{topSafeHeight + 64}}px;"><view class="back" bindtap="handleBack">‹</view><view class="title">收藏与想吃</view><view class="space"></view></view>
<scroll-view class="content" scroll-y><view class="tabs"><view class="tab {{tab === 'favorite' ? 'active' : ''}}" data-tab="favorite" bindtap="switchTab">收藏</view><view class="tab {{tab === 'wish' ? 'active' : ''}}" data-tab="wish" bindtap="switchTab">想吃</view></view>
<view wx:for="{{list}}" wx:key="menuId" class="item"><image class="thumb" src="{{item.menu.image}}" mode="aspectFill"></image><view class="body"><view class="name-row"><text class="name">{{item.menu.title}}</text><text wx:if="{{item.shared}}" class="shared">共同心愿</text></view><text class="meta">{{item.menu.categoryLabel}} · {{item.menu.available ? '现在可点' : '已下架'}}</text><view class="actions"><view data-id="{{item.menuId}}" bindtap="addCandidate">加入候选</view><view data-id="{{item.menuId}}" bindtap="addCart">购物车</view><view class="danger" data-id="{{item.menuId}}" bindtap="remove">移除</view></view></view></view>
<view wx:if="{{!loading && !list.length}}" class="empty">这里还没有内容</view><view wx:if="{{loading}}" class="empty">正在加载…</view></scroll-view></view>
