page{background:var(--rc-bg)}.page{height:100vh;overflow:hidden}.header{display:flex;align-items:center;justify-content:space-between;padding:0 var(--rc-page-gutter);box-sizing:border-box;border-bottom:1px solid var(--rc-border);background:var(--rc-surface-glass)}.back,.space{width:34px;height:34px}.back{border-radius:17px;background:var(--rc-surface);color:var(--rc-primary-strong);font-size:28px;line-height:31px;text-align:center}.title{font-size:19px;font-weight:700}.content{height:calc(100vh - 56px);padding:16px var(--rc-page-gutter) 30px;box-sizing:border-box}.tabs{display:flex;gap:8px;margin-bottom:14px}.tab{flex:1;height:36px;border-radius:11px;background:var(--rc-muted-bg);color:var(--rc-text-secondary);font-size:12px;line-height:36px;text-align:center}.tab.active{background:var(--rc-primary-container);color:var(--rc-primary-strong);font-weight:700}.item{display:flex;gap:12px;margin-bottom:12px;padding:12px;border-radius:16px;background:var(--rc-surface);border:1px solid var(--rc-border)}.thumb{width:70px;height:70px;border-radius:10px;background:var(--rc-muted-bg)}.body{min-width:0;flex:1}.name-row{display:flex;justify-content:space-between;gap:8px}.name{font-size:14px;font-weight:700}.shared{color:var(--rc-primary-strong);font-size:10px}.meta{display:block;margin-top:5px;color:var(--rc-text-secondary);font-size:10px}.actions{display:flex;gap:12px;margin-top:14px;color:var(--rc-primary-strong);font-size:11px}.actions .danger{margin-left:auto;color:var(--rc-danger)}.empty{padding:52px 16px;color:var(--rc-text-secondary);font-size:13px;text-align:center}
