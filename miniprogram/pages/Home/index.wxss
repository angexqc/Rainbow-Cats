page {
  background-color: var(--rc-bg);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--rc-bg);
  overflow: hidden;
}

.scroll-body {
  width: 100%;
  box-sizing: border-box;
  padding: 18px 16px;
  padding-bottom: var(--rc-scroll-bottom-gap);
}

.top-safe {
  width: 100%;
  flex-shrink: 0;
}

.section {
  margin-bottom: var(--rc-scroll-section-gap);
  animation: rc-scroll-enter var(--rc-scroll-enter-duration) var(--rc-ease-out) both;
}

.section:last-child {
  margin-bottom: 0;
}

.section:nth-child(2) { animation-delay: 40ms; }
.section:nth-child(3) { animation-delay: 80ms; }
.section:nth-child(4) { animation-delay: 120ms; }
.section:nth-child(5) { animation-delay: 160ms; }

.hero-card {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  background: var(--rc-surface-2);
  border: 1px solid rgba(191, 225, 208, 0.64);
  box-shadow: 0 8px 20px rgba(57, 80, 96, 0.07);
}

.hero-swiper {
  width: 100%;
  height: 208px;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(21, 44, 23, 0.34), rgba(36, 55, 36, 0.16));
}

.hero-copy {
  position: absolute;
  left: 16px;
  bottom: 16px;
  right: 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-title {
  color: var(--rc-on-primary);
  font-size: 18px;
  font-weight: 600;
}

.hero-sub {
  color: rgba(255, 255, 255, 0.92);
  font-size: 12px;
}

.pair-card,
.rank-card,
.popular-card {
  border-radius: 16px;
  background-color: var(--rc-surface);
  padding: 16px;
  border: 1px solid var(--rc-border);
  box-shadow: 0 6px 16px rgba(57, 80, 96, 0.06);
}

.pair-head,
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pair-title,
.card-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--rc-text);
}

.pair-state {
  font-size: 12px;
  padding: 3px 9px;
  border-radius: 10px;
}

.pair-state.on {
  background: var(--rc-primary-container);
  color: var(--rc-primary-strong);
}

.pair-state.off {
  background: var(--rc-muted-bg);
  color: var(--rc-text-secondary);
}

.pair-users {
  margin-top: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
}

.user-col {
  width: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 58px;
  height: 58px;
  border-radius: 29px;
  background: var(--rc-surface-2);
  border: 2px solid var(--rc-on-primary);
  box-shadow: 0 3px 9px rgba(36, 55, 36, 0.10);
}

.name {
  margin-top: 8px;
  text-align: center;
  font-size: 13px;
  color: var(--rc-text);
}

.pair-badge {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background-color: var(--rc-primary);
  color: var(--rc-on-primary);
  text-align: center;
  line-height: 28px;
  font-size: 14px;
  box-shadow: 0 6px 14px rgba(160, 214, 160, 0.18);
}

.pair-action {
  display: flex;
  justify-content: center;
}

.pair-btn {
  margin-top: 12px;
  height: 36px;
  line-height: 36px;
  border-radius: 18px;
  background-color: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 13px;
  width: 124px;
}

.period-switch {
  display: flex;
  gap: 6px;
}

.period-chip {
  min-width: 44px;
  height: 28px;
  padding: 0 8px;
  border-radius: 14px;
  background-color: var(--rc-chip-bg);
  color: var(--rc-text-secondary);
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.period-chip.active {
  background-color: var(--rc-primary);
  color: var(--rc-on-primary);
}

.rank-list {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.rank-item {
  min-height: 62px;
  padding: 12px;
  border-radius: 12px;
  background: var(--rc-surface-2);
  border: 1px solid rgba(191, 225, 208, 0.58);
  display: flex;
  align-items: center;
  gap: 12px;
}

.rank-item + .rank-item {
  border-top: none;
}

.rank-no {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  font-size: 13px;
  color: var(--rc-text-tertiary);
  background: var(--rc-on-primary);
  border: 1px solid var(--rc-border);
  text-align: center;
  font-weight: 600;
  line-height: 22px;
}

.rank-no.top {
  color: var(--rc-primary-strong);
  border-color: rgba(160, 214, 160, 0.30);
  background: linear-gradient(180deg, var(--rc-primary-container) 0%, var(--rc-surface) 100%);
}

.rank-thumb {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background-color: var(--rc-surface-2);
}

.rank-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.rank-name {
  font-size: 14px;
  color: var(--rc-text);
  font-weight: 600;
}

.rank-meta {
  font-size: 11px;
  color: var(--rc-text-secondary);
  letter-spacing: 0.15px;
}

.rank-action {
  margin-left: 4px;
}

.empty-box {
  margin-top: 16px;
  padding: 20px 0;
  text-align: center;
  color: var(--rc-text-secondary);
  font-size: 12px;
}

.popular-tag {
  font-size: 11px;
  color: var(--rc-primary-strong);
  background-color: var(--rc-primary-container);
  border-radius: 10px;
  padding: 2px 8px;
}

.popular-image {
  margin-top: 10px;
  width: 100%;
  height: 128px;
  border-radius: 10px;
  background-color: var(--rc-surface-2);
}

.popular-placeholder {
  margin-top: 10px;
  width: 100%;
  height: 128px;
  border-radius: 10px;
  background: var(--rc-surface-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.popular-placeholder-icon {
  font-size: 26px;
  line-height: 1;
}

.popular-placeholder-text {
  font-size: 12px;
  color: var(--rc-primary-strong);
}

.popular-body {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.popular-action {
  margin-top: 6px;
  display: flex;
  justify-content: flex-end;
}

.popular-name {
  font-size: 15px;
  color: var(--rc-text);
  font-weight: 600;
}

.popular-desc {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.mini-order-btn {
  min-width: 74px;
  height: 28px;
  padding: 0 12px;
  border-radius: 14px;
  background: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 12px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 14px rgba(160, 214, 160, 0.16);
}

.mini-qty {
  min-width: 74px;
  height: 28px;
  border-radius: 14px;
  background: var(--rc-primary-container);
  border: 1px solid var(--rc-border);
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.mini-op {
  width: 18px;
  height: 18px;
  border-radius: 9px;
  background: var(--rc-on-primary);
  color: var(--rc-primary-strong);
  font-size: 14px;
  line-height: 18px;
  text-align: center;
}

.mini-val {
  min-width: 18px;
  text-align: center;
  font-size: 12px;
  color: var(--rc-primary-strong);
  font-weight: 600;
}

.action-box {
  padding: 4px 0 0;
  display: flex;
  justify-content: center;
  gap: 0;
}

.order-btn {
  flex: 1;
  height: 46px;
  padding: 0;
  border-radius: 23px;
  background: var(--rc-primary);
  color: var(--rc-on-primary);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  box-shadow: 0 8px 18px rgba(79, 148, 82, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.order-btn::after {
  border: none;
}
