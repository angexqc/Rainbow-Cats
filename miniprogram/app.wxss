page {
  --rc-bg: #f4f7fb;
  --rc-bg-elevated: #edf3f8;
  --rc-surface: rgba(255, 255, 255, 0.74);
  --rc-surface-2: rgba(248, 251, 255, 0.58);
  --rc-surface-glass: rgba(255, 255, 255, 0.68);
  --rc-glass-strong: rgba(255, 255, 255, 0.82);
  --rc-glass-soft: rgba(255, 255, 255, 0.52);
  --rc-text: #1f2a33;
  --rc-text-secondary: #62717d;
  --rc-text-tertiary: #92a0aa;
  --rc-border: rgba(255, 255, 255, 0.62);
  --rc-border-strong: rgba(255, 255, 255, 0.86);
  --rc-hairline: rgba(93, 112, 128, 0.14);
  --rc-primary: #6ea6a1;
  --rc-primary-strong: #347c77;
  --rc-primary-container: rgba(218, 240, 238, 0.72);
  --rc-on-primary: #ffffff;
  --rc-on-primary-container: #24625e;
  --rc-warning-bg: rgba(255, 244, 214, 0.68);
  --rc-warning: #936a24;
  --rc-success-bg: rgba(219, 244, 226, 0.68);
  --rc-success: #3f8654;
  --rc-danger: #bf5b51;
  --rc-danger-soft: rgba(255, 225, 221, 0.72);
  --rc-muted-bg: rgba(239, 244, 248, 0.66);
  --rc-muted: #778894;
  --rc-chip-bg: rgba(255, 255, 255, 0.54);
  --rc-radius-card: 20px;
  --rc-radius-field: 16px;
  --rc-shadow-card: 0 10px 26px rgba(57, 80, 96, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.72);
  --rc-shadow-fab: 0 10px 22px rgba(52, 124, 119, 0.18);
  --rc-shadow-nav: 0 8px 22px rgba(57, 80, 96, 0.08), inset 0 -1px 0 rgba(255, 255, 255, 0.60);
  --rc-page-gutter: 16px;
  --rc-space-1: 4px;
  --rc-space-2: 8px;
  --rc-space-3: 12px;
  --rc-space-4: 16px;
  --rc-space-6: 24px;
  --rc-space-8: 32px;
  --rc-safe-bottom: env(safe-area-inset-bottom);
  --rc-bottom-bar-height: 72px;
  --footer-height: 10vh;
  --button-size: 16vw;
  --button-color: #353535;
  --button-icon-size: 6vw;
  --rc-font-body: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  --rc-font-display: "STSong", "Songti SC", serif;
  --rc-motion-micro: 140ms;
  --rc-motion-fast: 220ms;
  --rc-motion-medium: 320ms;
  --rc-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --rc-ease-in: cubic-bezier(0.55, 0, 1, 0.45);
  --rc-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --rc-ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --rc-scroll-top-gap: 16px;
  --rc-scroll-bottom-gap: 18px;
  --rc-scroll-section-gap: 18px;
  --rc-scroll-enter-duration: 420ms;
  --rc-scroll-enter-distance: 14px;
}

page {
  background:
    radial-gradient(circle at 18% 0%, rgba(181, 220, 235, 0.62) 0, rgba(181, 220, 235, 0) 34%),
    radial-gradient(circle at 88% 12%, rgba(255, 223, 207, 0.66) 0, rgba(255, 223, 207, 0) 32%),
    linear-gradient(180deg, var(--rc-bg) 0%, var(--rc-bg-elevated) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  color: var(--rc-text);
  font-family: var(--rc-font-body);
  letter-spacing: 0.1px;
}

.container.white {
  background-color: transparent;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
  margin-bottom: 80px;
}

.header,
.block,
.info-card,
.desc-section,
.pair-card,
.rank-card,
.popular-card,
.order-item,
.menu-item {
  box-shadow: var(--rc-shadow-card);
  transition: transform var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), background-color var(--rc-motion-fast) var(--rc-ease-out);
}

.title,
.page-title,
.card-title,
.section-title {
  font-family: var(--rc-font-display);
  letter-spacing: 0.4px;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.form-group {
  width: calc(100% - 40px);
  margin: 10px 20px;
  border-radius: 12px;
  border: 1px solid var(--rc-border);
  background: var(--rc-surface);
}

.form-group_label {
  align-self: flex-start;
  margin-top: 20px;
  margin-left: 20px;
  color: var(--rc-text-secondary);
  font-size: 15px;
}

.form-group_label:not(:first-child) {
  margin-top: 20px;
}

.form-cell {
  padding: 20px 15px;
}

.form-cell:not(:last-child) {
  border-bottom: 1px solid var(--rc-border);
}

.form-cell.inline {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

@keyframes animation-blur {
  from {filter: blur(7px);}
  to {filter: blur(0px);}
}

.icon-action {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background: var(--rc-surface);
  border: 1px solid var(--rc-border-strong);
  color: var(--rc-text-secondary);
  font-size: 14px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out);
}

.icon-action.compact {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  font-size: 12px;
}

.icon-action.danger {
  color: var(--rc-danger);
  border-color: #f0cfc9;
  background: #fff7f5;
}

.icon-action.primary {
  color: var(--rc-primary);
  border-color: var(--rc-primary-container);
  background: #eef8ee;
}

.icon-action:active {
  transform: translateY(1px) scale(0.94);
}

.biz-action {
  min-height: 42px;
  border-radius: 21px;
  padding: 0 16px;
  border: 1px solid transparent;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.2px;
  box-sizing: border-box;
  transition: transform 0.16s ease, filter 0.16s ease, box-shadow 0.16s ease;
}

.biz-action:active {
  transform: translateY(1px) scale(0.985);
  filter: brightness(0.98);
}

.chip,
.qty-btn,
.qty-op,
.order-btn,
.add-category-btn,
.cart-mini,
.add-icon,
.check {
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.chip:active,
.qty-btn:active,
.qty-op:active,
.order-btn:active,
.add-category-btn:active,
.cart-mini:active,
.add-icon:active,
.check:active {
  transform: translateY(1px) scale(0.96);
}

.biz-action.biz-primary {
  background: var(--rc-primary);
  border-color: var(--rc-primary);
  color: var(--rc-on-primary);
  box-shadow: 0 8px 20px rgba(79, 148, 82, 0.28);
}

.biz-action.biz-secondary {
  background: var(--rc-surface);
  border-color: var(--rc-border);
  color: var(--rc-primary-strong);
}

.biz-action.biz-danger {
  background: var(--rc-danger);
  border-color: var(--rc-danger);
  color: var(--rc-on-primary);
}

.biz-action.biz-muted {
  background: var(--rc-surface-2);
  border-color: var(--rc-border);
  color: var(--rc-text-secondary);
}

.cat-loader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

@keyframes rc-scroll-enter {
  from {
    opacity: 0;
    transform: translate3d(0, var(--rc-scroll-enter-distance), 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

.cat-loader-img {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  animation: cat-bounce 1.05s ease-in-out infinite;
}

.cat-loader-text {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.cat-inline-loader {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.cat-inline-loader .cat-loader-img {
  width: 24px;
  height: 24px;
  border-radius: 12px;
}

@keyframes cat-bounce {
  0%, 100% {
    transform: translateY(0) scale(0.96);
    opacity: 0.86;
  }
  50% {
    transform: translateY(-5px) scale(1.04);
    opacity: 1;
  }
}

.loading-panel {
  animation: rc-loader-breathe 1.65s var(--rc-ease-in-out) infinite;
}

@keyframes rc-loader-breathe {
  0%, 100% {
    transform: translateY(0) scale(0.985);
  }
  50% {
    transform: translateY(-2px) scale(1);
  }
}

