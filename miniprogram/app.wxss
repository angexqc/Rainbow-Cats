  gap: 12px;
}

page .chip,
page .period-chip,
page .status-tag,
page .feedback-btn,
page .header-delete,
page .header-save {
  min-height: 34px;
}

page .icon-action,
page .qty-op,
page .qty-btn,
page .add-icon {
  min-width: 34px;
  min-height: 34px;
}

page .loading-panel,
page .cat-loader,
page .cat-inline-loader {
  box-shadow: none !important;
}

page .top-fixed,
page .status-tabs,
page .category-scroll,
page .owner-scroll {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
}

/* Cute Material pass from the Figma Site reference. */
page .header {
  min-height: 54px !important;
  background: transparent !important;
  border-bottom: 0 !important;
  box-shadow: none !important;
}

page .title,
page .magazine-title,
page .hero-title,
page .wheel-title,
page .block-title,
page .card-title {
  font-weight: 850 !important;
  letter-spacing: 0 !important;
}

page .chip,
page .period-chip,
page .status-tag,
page .category-flag,
page .popular-tag {
  border-radius: 999px !important;
  border-color: rgba(67, 173, 120, 0.14) !important;
  background: var(--rc-chip-bg) !important;
  color: var(--rc-text-secondary) !important;
  font-weight: 750 !important;
}

page .chip.active,
page .period-chip.active,
page .status-tag.status-pending,
page .popular-tag {
  background: var(--rc-primary-container) !important;
  color: var(--rc-primary-strong) !important;
}

page .status-tag.status-confirmed,
page .chip-owner.active {
  background: var(--rc-accent-container) !important;
  color: var(--rc-accent-strong) !important;
}

page .status-tag.status-completed {
  background: var(--rc-success-bg) !important;
  color: var(--rc-success) !important;
}

page .status-tag.status-cancelled {
  background: var(--rc-muted-bg) !important;
  color: var(--rc-muted) !important;
}

page .biz-action.biz-secondary,
page .home-btn,
page .feedback-btn,
page .wheel-again {
  background: var(--rc-accent-container) !important;
  border-color: transparent !important;
  color: #32998d !important;
}

page .header-delete,
page .biz-action.biz-danger,
page .unbind-btn,
page .unbind-pair-btn {
  background: var(--rc-danger-soft) !important;
  border-color: rgba(226, 85, 111, 0.18) !important;
  color: var(--rc-danger) !important;
}

page .biz-action.biz-danger {
  color: var(--rc-on-primary) !important;
}

page .rank-no.top,
page .flow-point.active,
page .mini-count,
page .category-flag {
  background: var(--rc-primary) !important;
  color: var(--rc-on-primary) !important;
}

page .rank-no,
page .flow-point,
page .day-dot {
  background: var(--rc-accent) !important;
}

page .bottom-bar {
  left: 14px !important;
  right: 14px !important;
  bottom: calc(10px + var(--rc-safe-bottom)) !important;
  border-radius: 26px !important;
  min-height: 58px !important;
  padding: 8px 10px !important;
}

/* Responsive geometry: let each page consume the real viewport instead of
   subtracting a hard-coded 56px from 100vh. */
page .page {
  height: 100vh !important;
  min-height: 0 !important;
  overflow: hidden !important;
  box-sizing: border-box;
}

page .page > .header {
  flex: 0 0 auto;
  min-height: 64px;
  box-sizing: border-box;
}

page .page > .content,
page .page > .scroll-body {
  flex: 1 1 auto;
  min-height: 0 !important;
  max-height: none !important;
  overflow-y: auto;
  box-sizing: border-box;
  padding-bottom: 0 !important;
  -webkit-overflow-scrolling: touch;
}

page .page > .content.has-bottom-bar {
  padding-bottom: 0 !important;
}

/* Keep visual assets and icon controls geometrically stable inside flex rows. */
page .icon-action,
page .add-icon,
page .cart-mini,
page .history-mini,
page .back-btn,
page .scan-icon-btn,
page .copy-icon-btn,
page .like-icon-btn,
page .calendar-icon,
page .avatar,
page .couple-avatar,
page .actor-avatar,
page .owner-avatar {
  aspect-ratio: 1 / 1;
  flex: 0 0 auto;
}

page image.avatar,
page image.actor-avatar,
page image.owner-avatar,
page image.thumb,
page image.item-thumb,
page image.rank-thumb,
page image.popular-image,
page image.banner-thumb,
page image.big-image,
page image.upload-preview,
page image.qr-image {
  aspect-ratio: 1 / 1;
  object-fit: cover;
  flex: 0 0 auto;
}

@media (max-width: 360px) {
  page {
    --rc-page-gutter: 16px;
    --rc-scroll-section-gap: 20px;
  }

  page .page > .content,
  page .page > .scroll-body {
    padding-top: 8px !important;
  }

  page .hero-card,
  page .pair-card,
  page .rank-card,
  page .popular-card,
  page .calendar-card,
  page .record-card,
  page .summary-card,
  page .status-card,
  page .form-card,
  page .profile-card,
  page .setting-card,
  page .notify-card,
  page .detail-card,
  page .cart-card,
  page .card,
  page .block {
    padding: 16px !important;
  }

  page .magazine-hero,
  page .magazine-swiper,
  page .magazine-slide {
    height: 276px;
  }

  page .magazine-title {
    font-size: 26px;
  }
}

@media (max-height: 680px) {
  page .header {
    min-height: 50px !important;
  }

  page .page > .content,
  page .page > .scroll-body {
    padding-top: 8px !important;
  }

  page .magazine-hero,
  page .magazine-swiper,
  page .magazine-slide {
    height: 268px;
  }

  page .magazine-copy {
    bottom: 24px;
  }

  page .bottom-bar {
    min-height: 52px !important;
    padding: 6px 8px !important;
  }
}

@media (orientation: landscape) and (max-height: 500px) {
  page .page > .content,
  page .page > .scroll-body {
    padding-bottom: 0 !important;
  }

  page .page > .content.has-bottom-bar {
    padding-bottom: var(--rc-safe-bottom);
  }

  page .bottom-bar {
    left: 10px !important;
    right: 10px !important;
    bottom: calc(6px + var(--rc-safe-bottom)) !important;
    min-height: 48px !important;
    padding: 4px 8px !important;
  }
}

/* Legacy pink/cocoa override removed: Fresh Garden owns the shared theme. */
@media (prefers-reduced-motion: reduce) { page .page, page .header, page .content, page .scroll-body, page .bottom-bar { animation:none !important; transition:none !important; } }

/* Fresh Garden A: shared visual system. This final layer intentionally
   supersedes the legacy pink/cocoa polish while preserving page structure. */
page {
  --rc-bg: #f3fbf6;
  --rc-bg-elevated: #e8f7ee;
  --rc-surface: #ffffff;
  --rc-surface-2: #f1faf4;
  --rc-text: #24332a;
  --rc-text-secondary: #5f7567;
  --rc-text-tertiary: #8aa092;
  --rc-border: #c9e4d4;
  --rc-border-strong: #b4d8c2;
  --rc-primary: #43ad78;
  --rc-primary-strong: #257a50;
  --rc-primary-container: #d3f2e0;
  --rc-on-primary: #ffffff;
  --rc-on-primary-container: #1e6843;
  --rc-accent: #65c8b1;
  --rc-accent-container: #daf6ed;
  --rc-warning-bg: #fff5d2;
  --rc-warning: #9a7416;
  --rc-success-bg: #e0f9ef;
  --rc-success: #2f8d69;
  --rc-danger: #e2556f;
  --rc-danger-soft: #ffe7ec;
  --rc-muted-bg: #e8f2eb;
  --rc-muted: #72877a;
  --rc-chip-bg: #ffffff;
  --rc-radius-card: 24px;
  --rc-radius-field: 14px;
  --rc-shadow-card: 0 10px 26px rgba(45, 137, 87, .10), 0 1px 0 rgba(255,255,255,.92) inset;
  --rc-shadow-fab: 0 10px 22px rgba(45, 137, 87, .22);
  --rc-shadow-nav: 0 8px 24px rgba(45, 137, 87, .12), 0 1px 0 rgba(255,255,255,.9) inset;
  --rc-font-body: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  --rc-font-display: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  color: var(--rc-text) !important;
  background: var(--rc-bg) !important;
  font-family: var(--rc-font-body) !important;
}

page .page,
page .container,
page .content,
page .scroll-body,
page .profile-fixed,
page .top-fixed {
  background: var(--rc-bg) !important;
  color: var(--rc-text) !important;
}

page .header,
page .card,
page .block,
page .form-card,
page .setting-card,
page .detail-card,
page .menu-item,
page .order-item,
page .info-card,
page .pair-card,
page .record-card,
page .rank-card,
page .popular-card,
page .calendar-card,
page .summary-card,
page .status-card,
page .cart-card,
page .profile-card,
page .notify-card {
  background: var(--rc-surface) !important;
  border: 1px solid var(--rc-border) !important;
  border-radius: var(--rc-radius-card) !important;
  box-shadow: var(--rc-shadow-card) !important;
}

page .header {
  color: var(--rc-text) !important;
  padding-left: var(--rc-page-gutter) !important;
  padding-right: var(--rc-page-gutter) !important;
}

page .title,
page .page-title,
page .section-title,
page .card-title,
page .block-title,
page .header .title {
  color: var(--rc-text) !important;
  font-family: var(--rc-font-display) !important;
  font-weight: 700 !important;
  letter-spacing: -.01em !important;
}

page .subtitle,
page .card-desc,
page .block-desc,
page .item-info_desc,
page .muted,
page .hint,
page .empty-desc {
  color: var(--rc-text-secondary) !important;
}

page input,
page textarea,
page .field,
page .search-bar,
page .search-input,
page .form-group,
page .form-cell {
  background: var(--rc-surface) !important;
  border-color: var(--rc-border) !important;
  border-radius: var(--rc-radius-field) !important;
  color: var(--rc-text) !important;
}

page input::placeholder,
page textarea::placeholder { color: var(--rc-text-tertiary) !important; }

page button,
page .btn-normal,
page .submit-btn,
page .save,
page .add-btn,
page .pair-btn,
page .order-btn,
page .biz-action.biz-primary,
page .mini-order-btn {
  background: var(--rc-primary) !important;
  border: 1px solid var(--rc-primary) !important;
  border-radius: 14px !important;
  color: var(--rc-on-primary) !important;
  box-shadow: 0 5px 12px rgba(45,137,87,.16) !important;
  font-weight: 650 !important;
}

page .biz-action.biz-secondary,
page .reset,
page .home-btn,
page .btn-secondary,
page .order-btn-secondary {
  background: var(--rc-primary-container) !important;
  border: 1px solid var(--rc-border) !important;
  border-radius: 14px !important;
  color: var(--rc-on-primary-container) !important;
  box-shadow: none !important;
}

page .chip,
page .period-chip,
page .status-tag,
page .tag,
page .category-flag,
page .owner-filter {
  background: var(--rc-chip-bg) !important;
  border: 1px solid var(--rc-border) !important;
  border-radius: 999px !important;
  color: var(--rc-text-secondary) !important;
}

page .chip.active,
page .period-chip.active,
page .status-tag.success,
page .tag.active,
page .category-flag.active {
  background: var(--rc-primary-container) !important;
  border-color: var(--rc-primary) !important;
  color: var(--rc-on-primary-container) !important;
}

page .status-pending,
page .pending,
page .warning,
page .status-tag.pending {
  background: var(--rc-warning-bg) !important;
  color: var(--rc-warning) !important;
}

page .danger,
page .status-cancelled,
page .status-tag.danger,
page .error-text {
  background: var(--rc-danger-soft) !important;
  color: var(--rc-danger) !important;
}

page .success,
page .status-completed,
page .status-tag.completed {
  background: var(--rc-success-bg) !important;
  color: var(--rc-success) !important;
}

page .bottom-bar {
  background: var(--rc-surface) !important;
  border: 1px solid var(--rc-border) !important;
  border-radius: 24px !important;
  box-shadow: var(--rc-shadow-nav) !important;
}

page .bottom-bar .active,
page .bottom-bar .selected,
page .tab-item.active,
page .tab-item.selected { color: var(--rc-primary-strong) !important; }

page .icon-action.primary,
page .add-icon,
page .cart-mini,
page .fab {
  background: var(--rc-primary-container) !important;
  border-color: var(--rc-border) !important;
  color: var(--rc-primary-strong) !important;
  box-shadow: var(--rc-shadow-fab) !important;
}

page .icon-action.danger,
page .delete,
page .remove { background: var(--rc-danger-soft) !important; color: var(--rc-danger) !important; }

page .form-cell,
page .setting-row,
page .detail-row,
page .order-line,
page .divider { border-color: var(--rc-border) !important; }

page .empty-box,
page .empty-state,
page .loading-panel,
page .error-box { color: var(--rc-text-secondary) !important; }

page .empty-box::before,
page .empty-state::before { color: var(--rc-accent) !important; }

@media (max-width: 360px) {
  page { --rc-page-gutter: 16px; --rc-radius-card: 20px; }
  page .header { padding-left: 16px !important; padding-right: 16px !important; }
  page .biz-action, page button, page .order-btn { min-height: 42px; }
}
