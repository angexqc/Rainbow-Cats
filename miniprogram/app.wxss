page {
  --rc-bg: #f3fbf6;
  --rc-bg-elevated: #e8f7ee;
  --rc-surface: rgba(255, 255, 255, 0.94);
  --rc-surface-2: rgba(238, 249, 242, 0.92);
  --rc-surface-glass: rgba(255, 255, 255, 0.88);
  --rc-glass-strong: rgba(255, 255, 255, 0.94);
  --rc-glass-soft: rgba(241, 250, 244, 0.84);
  --rc-text: #24332a;
  --rc-text-secondary: #65796c;
  --rc-text-tertiary: #91a79a;
  --rc-border: rgba(201, 228, 212, 0.84);
  --rc-border-strong: rgba(255, 255, 255, 0.96);
  --rc-hairline: rgba(67, 173, 120, 0.16);
  --rc-primary: #43ad78;
  --rc-primary-strong: #257a50;
  --rc-primary-container: rgba(211, 242, 224, 0.94);
  --rc-on-primary: #ffffff;
  --rc-on-primary-container: #1e6843;
  --rc-accent: #65c8b1;
  --rc-accent-strong: #318f78;
  --rc-accent-container: rgba(218, 246, 237, 0.95);
  --rc-sun: #ffd36f;
  --rc-sun-soft: rgba(255, 216, 136, 0.34);
  --rc-warning-bg: rgba(255, 245, 210, 0.92);
  --rc-warning: #c89520;
  --rc-success-bg: rgba(224, 249, 239, 0.92);
  --rc-success: #3ba87d;
  --rc-danger: #e2556f;
  --rc-danger-soft: rgba(255, 231, 236, 0.92);
  --rc-muted-bg: rgba(232, 242, 235, 0.9);
  --rc-muted: #83968a;
  --rc-chip-bg: rgba(255, 255, 255, 0.88);
  --rc-radius-card: 28px;
  --rc-radius-field: 22px;
  --rc-shadow-card: 0 16px 34px rgba(45, 137, 87, 0.13), 0 1px 0 rgba(255, 255, 255, 0.92) inset;
  --rc-shadow-fab: 0 14px 28px rgba(45, 137, 87, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.34);
  --rc-shadow-nav: 0 14px 30px rgba(45, 137, 87, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.88);
  --rc-page-gutter: 18px;
  --rc-space-1: 4px;
  --rc-space-2: 8px;
  --rc-space-3: 12px;
  --rc-space-4: 16px;
  --rc-space-6: 24px;
  --rc-space-8: 32px;
  --rc-safe-bottom: env(safe-area-inset-bottom);
  --rc-bottom-bar-height: 72px;
  --footer-height: 10vh;
  --button-size: 16vw;
  --button-color: #203128;
  --button-icon-size: 6vw;
  --rc-font-body: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  --rc-font-display: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  --rc-motion-micro: 140ms;
  --rc-motion-fast: 220ms;
  --rc-motion-medium: 320ms;
  --rc-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --rc-ease-in: cubic-bezier(0.55, 0, 1, 0.45);
  --rc-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --rc-ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --rc-scroll-top-gap: 16px;
  --rc-scroll-bottom-gap: 16px;
  --rc-scroll-section-gap: 24px;
  --rc-scroll-enter-duration: 420ms;
  --rc-scroll-enter-distance: 14px;
}

page {
  background:
    radial-gradient(circle at 14% -4%, rgba(211, 242, 224, 0.95) 0, rgba(211, 242, 224, 0) 36%),
    radial-gradient(circle at 96% 8%, rgba(220, 241, 198, 0.72) 0, rgba(220, 241, 198, 0) 30%),
    radial-gradient(circle at 78% 84%, rgba(209, 241, 231, 0.84) 0, rgba(209, 241, 231, 0) 32%),
    linear-gradient(180deg, var(--rc-bg) 0%, var(--rc-bg-elevated) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  color: var(--rc-text);
  font-family: var(--rc-font-body);
  letter-spacing: 0;
}

.container.white {
  background-color: transparent;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
  margin-bottom: 80px;
}

.header,
.block,
.info-card,
.desc-section,
.pair-card,
.rank-card,
.popular-card,
.order-item,
.menu-item {
  box-shadow: var(--rc-shadow-card);
  transition: transform var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), background-color var(--rc-motion-fast) var(--rc-ease-out);
}

.header-title-group {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.subtitle {
  max-width: 230px;
  color: var(--rc-text-secondary);
  font-size: 11px;
  font-weight: 750;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.title,
.page-title,
.card-title,
.section-title {
  font-family: var(--rc-font-display);
  letter-spacing: 0.4px;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.form-group {
  width: calc(100% - 40px);
  margin: 10px 20px;
  border-radius: 12px;
  border: 1px solid var(--rc-border);
  background: var(--rc-surface);
}

.form-group_label {
  align-self: flex-start;
  margin-top: 20px;
  margin-left: 20px;
  color: var(--rc-text-secondary);
  font-size: 15px;
}

.form-group_label:not(:first-child) {
  margin-top: 20px;
}

.form-cell {
  padding: 20px 15px;
}

.form-cell:not(:last-child) {
  border-bottom: 1px solid var(--rc-border);
}

.form-cell.inline {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

@keyframes animation-blur {
  from {filter: blur(7px);}
  to {filter: blur(0px);}
}

.icon-action {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background: var(--rc-surface);
  border: 1px solid var(--rc-border-strong);
  color: var(--rc-text-secondary);
  font-size: 14px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out);
}

.icon-action.compact {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  font-size: 12px;
}

.icon-action.danger {
  color: var(--rc-danger);
  border-color: rgba(226, 85, 111, 0.18);
  background: var(--rc-danger-soft);
}

.icon-action.primary {
  color: var(--rc-primary);
  border-color: var(--rc-primary-container);
  background: var(--rc-primary-container);
}

.icon-action:active {
  transform: translateY(1px) scale(0.94);
}

.biz-action {
  min-height: 42px;
  border-radius: 21px;
  padding: 0 16px;
  border: 1px solid transparent;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.2px;
  box-sizing: border-box;
  transition: transform 0.16s ease, filter 0.16s ease, box-shadow 0.16s ease;
}

.biz-action:active {
  transform: translateY(1px) scale(0.985);
  filter: brightness(0.98);
}

.chip,
.qty-btn,
.qty-op,
.order-btn,
.add-category-btn,
.cart-mini,
.add-icon,
.check {
  transition: transform var(--rc-motion-micro) var(--rc-ease-spring), background-color var(--rc-motion-fast) var(--rc-ease-out), border-color var(--rc-motion-fast) var(--rc-ease-out), color var(--rc-motion-fast) var(--rc-ease-out), box-shadow var(--rc-motion-fast) var(--rc-ease-out), opacity var(--rc-motion-fast) var(--rc-ease-out);
}

.chip:active,
.qty-btn:active,
.qty-op:active,
.order-btn:active,
.add-category-btn:active,
.cart-mini:active,
.add-icon:active,
.check:active {
  transform: translateY(1px) scale(0.96);
}

.biz-action.biz-primary {
  background: linear-gradient(180deg, #75cca0 0%, var(--rc-primary) 100%);
  border-color: var(--rc-primary);
  color: var(--rc-on-primary);
  box-shadow: var(--rc-shadow-fab);
}

.biz-action.biz-secondary {
  background: var(--rc-surface);
  border-color: var(--rc-border);
  color: var(--rc-primary-strong);
}

.biz-action.biz-danger {
  background: var(--rc-danger-soft);
  border-color: rgba(226, 85, 111, 0.22);
  color: var(--rc-danger);
}

.biz-action.biz-danger {
  background: var(--rc-danger);
  border-color: var(--rc-danger);
  color: var(--rc-on-primary);
}

.biz-action.biz-muted {
  background: var(--rc-surface-2);
  border-color: var(--rc-border);
  color: var(--rc-text-secondary);
}

.cat-loader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

@keyframes rc-scroll-enter {
  from {
    opacity: 0;
    transform: translate3d(0, var(--rc-scroll-enter-distance), 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

.cat-loader-img {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  animation: cat-bounce 1.05s ease-in-out infinite;
}

.cat-loader-text {
  font-size: 12px;
  color: var(--rc-text-secondary);
}

.cat-inline-loader {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.cat-inline-loader .cat-loader-img {
  width: 24px;
  height: 24px;
  border-radius: 12px;
}

@keyframes cat-bounce {
  0%, 100% {
    transform: translateY(0) scale(0.96);
    opacity: 0.86;
  }
  50% {
    transform: translateY(-5px) scale(1.04);
    opacity: 1;
  }
}

.loading-panel {
  animation: rc-loader-breathe 1.65s var(--rc-ease-in-out) infinite;
}

@keyframes rc-loader-breathe {
  0%, 100% {
    transform: translateY(0) scale(0.985);
  }
  50% {
    transform: translateY(-2px) scale(1);
  }
}

