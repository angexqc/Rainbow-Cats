@import '../../miniprogram_npm/weui-miniprogram/weui-wxss/dist/style/weui.wxss';

  .background {
    width: 70vw;
    margin-top: 5vh;
  }
  
  .title {
    margin-top: 20px;
    font-size: 17px;
    font-weight: bold;
  }
  .subtitle {
    margin-top: 9px;
    font-size: 12px;
  }
  
  .swiper-image{
    display: block;
    height: 100%; 
    width: 100%;
    background-color: var(--rc-muted-bg);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  
  .form-cell {padding: 12px;}
  .slide {
    display: flex;
    align-items: center;
    padding: 12px;
    position: relative;
  }
  
  .item-info {
    width: auto;
    margin-left: 10px;
    display: flex;
    flex-direction: column
  }
  .item-info_title {
    font-size: 18px;
  }
  .item-info_desc {
    font-size: 10px;
    color: var(--rc-text-secondary);
  }
  .item-info_date {
    font-size: 10px;
    color: var(--rc-text-secondary);
  }
  .item-info_author {
    width: 70px;
    height: 100%;
    position: absolute;
    right: 10%;
    bottom: 0;
  }
  .item-info_award {
    font-size: 10px;
  }
  .star {
    width: 40px;
    height: 40px;
    position: absolute;
    right: 0;
    top: 0;
  }
  
  .useBtn .weui-slideview__btn {background-color: var(--rc-primary);}
  .starBtn .weui-slideview__btn {background-color: #e7b959;}
  .removeBtn .weui-slideview__btn {background-color: var(--rc-danger);}
  
  .btn-normal{
    margin: 2%;
    color: var(--rc-on-primary);
    background-color: var(--rc-primary);
  }
  .btn-hover{
    color: var(--rc-on-primary);
    background-color: var(--rc-primary-strong);
  }
  
  .search-bar {
    position: relative;
    width: 100%;
    display: flex;
    box-sizing: border-box;
    background-color: var(--rc-glass-soft);
    border: 1rpx solid var(--rc-hairline);
    border-radius: var(--rc-radius-field);
  }
  .search-input {
    position: relative;
    left: 28px;
    height: 28px;
    width: 80%;
    line-height: 28px;
    font-size: 14px;
  }
  .search-icon {
    position: absolute;
    margin: 2px;
  }
